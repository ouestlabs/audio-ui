{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "audio-ui-lab",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "assets": {
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash"
  }
}
