{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@audio-ui/core": ["../../packages/core/src/index.ts"],
      "@audio-ui/core/internal": ["../../packages/core/src/internal.ts"],
      "@audio-ui/core/*": [
        "../../packages/core/src/primitives/*/index.ts",
        "../../packages/core/src/audio/*/index.ts"
      ],
      "@audio-ui/react": ["../../packages/ui/src/index.ts"],
      "@audio-ui/react/*": ["../../packages/ui/src/entries/*.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
