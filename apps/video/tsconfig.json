{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "paths": {
      "@/components/icon-placeholder": ["./src/icon-placeholder.tsx"],
      "@/*": ["../www/src/*"],
      "@/components/audio-ui/parameter-field": [
        "../www/src/registry/bases/ui-sdk/audio/elements/parameter-field.tsx"
      ],
      "@/components/audio-ui/rocker-switch": [
        "../www/src/registry/bases/ui-sdk/audio/elements/rocker-switch.tsx"
      ],
      "@/primitives/envelope": [
        "../www/src/registry/bases/shared/primitives/envelope/envelope.ts"
      ],
      "@/primitives/fader": [
        "../www/src/registry/bases/shared/primitives/fader/fader.ts"
      ],
      "@/primitives/knob": [
        "../www/src/registry/bases/shared/primitives/knob/knob.ts"
      ],
      "@/primitives/meter": [
        "../www/src/registry/bases/shared/primitives/meter/meter.ts"
      ],
      "@/primitives/pad": [
        "../www/src/registry/bases/shared/primitives/pad/pad.ts"
      ],
      "@/primitives/piano": [
        "../www/src/registry/bases/shared/primitives/piano/piano.ts"
      ],
      "@/primitives/piano-roll": [
        "../www/src/registry/bases/shared/primitives/piano-roll/piano-roll.ts"
      ],
      "@/primitives/plot": [
        "../www/src/registry/bases/shared/primitives/plot/plot.ts"
      ],
      "@/primitives/sequencer": [
        "../www/src/registry/bases/shared/primitives/sequencer/sequencer.ts"
      ],
      "@/primitives/timeline": [
        "../www/src/registry/bases/shared/primitives/timeline/timeline.ts"
      ],
      "@/primitives/waveform": [
        "../www/src/registry/bases/shared/primitives/waveform/waveform.ts"
      ],
      "@/primitives/xypad": [
        "../www/src/registry/bases/shared/primitives/xypad/xypad.ts"
      ],
      "@/engine/*": ["../www/src/registry/bases/shared/lib/engine/*/index.ts"]
    },
    "types": ["bun", "react", "react-dom"]
  },
  "include": ["src", "scripts", "*.ts"],
  "exclude": ["node_modules", "out"]
}
