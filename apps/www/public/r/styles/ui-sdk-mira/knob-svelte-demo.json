{"$schema":"https://ui.shadcn.com/schema/registry-item.json","description":"Knob example, in the Svelte adapter","files":[{"content":"<script lang=\"ts\">\nimport { Knob } from \"$lib/components/audio-ui/knob/svelte\";\n</script>\n\n<Knob.Root\n  class=\"rounded-full border border-transparent ring-1 ring-foreground/10 transition-[border-color,box-shadow] duration-150 ease-out focus-within:border-ring focus-within:ring-2 focus-within:ring-ring/30 hover:ring-2 hover:ring-ring/30 has-[[data-slot=knob-control]:active]:border-ring has-[[data-slot=knob-control]:active]:ring-2 has-[[data-slot=knob-control]:active]:ring-ring motion-reduce:transition-none size-16 group/knob relative m-5 mb-12 inline-flex outline-none data-disabled:cursor-not-allowed\"\n  defaultValue={50}\n  max={100}\n  min={0}\n  step={1}\n>\n  <Knob.Control\n    class=\"bg-[color:var(--audio-socket,var(--secondary))] text-secondary-foreground shadow-xs transition-[color,background-color,box-shadow,border-color,opacity] duration-150 ease-out hover:bg-[color:var(--audio-socket,color-mix(in_oklab,var(--secondary)_90%,transparent))] active:shadow-[inset_0_-14px_28px_-12px_rgb(0_0_0/0.14)] motion-reduce:transition-none dark:bg-[color:var(--audio-socket,color-mix(in_oklab,var(--secondary)_60%,transparent))] dark:hover:bg-[color:var(--audio-socket,color-mix(in_oklab,var(--secondary)_70%,transparent))] dark:active:shadow-[inset_0_-14px_28px_-12px_rgb(0_0_0/0.28)] transform-[translateZ(0)] relative isolate flex size-full cursor-grab touch-none select-none outline-none [clip-path:circle(50%_at_50%_50%)] focus-visible:outline-none active:cursor-grabbing data-disabled:pointer-events-none data-disabled:opacity-50 data-[drag-mode=vertical]:cursor-ns-resize data-[drag-mode=vertical]:active:cursor-ns-resize\"\n  >\n    <div class=\"rounded-full bg-[color:var(--audio-cap,var(--card))] text-card-foreground ring-1 ring-foreground/10 transition-transform duration-100 ease-out motion-reduce:transition-none inset-2 absolute z-0\"></div>\n    <Knob.Track\n      class=\"text-[color:var(--audio-accent,var(--primary))] [&_path]:stroke-current pointer-events-none absolute inset-0 z-1 block size-full opacity-22\"\n    />\n    <Knob.Indicator\n      class=\"text-[color:var(--audio-accent,var(--primary))] [&_path]:stroke-current pointer-events-none absolute inset-0 z-1 block size-full\"\n    />\n    <Knob.Thumb\n      aria-label=\"Level\"\n      class=\"pointer-events-none absolute inset-0 z-2\"\n    >\n      <svg\n        aria-hidden=\"true\"\n        class=\"text-[color:var(--audio-accent,var(--primary))] block size-full\"\n        viewBox=\"0 0 48 48\"\n      >\n        <line\n          stroke=\"currentColor\"\n          stroke-linecap=\"round\"\n          stroke-width=\"2.75\"\n          x1=\"24\"\n          x2=\"24\"\n          y1=\"11.53\"\n          y2=\"18.84\"\n        />\n      </svg>\n    </Knob.Thumb>\n  </Knob.Control>\n  <Knob.Mark value={0}>\n    <span\n      class=\"bg-[color:var(--audio-print,color-mix(in_oklab,var(--muted-foreground)_40%,transparent))] transition-colors duration-150 ease-out in-data-[selected]:data-[color]:bg-[color:var(--audio-accent,var(--primary))] motion-reduce:transition-none -top-2.5 absolute left-1/2 h-1.5 w-px -translate-x-1/2\"\n    ></span>\n    <span\n      class=\"text-[10px] leading-none text-[color:var(--audio-print,var(--muted-foreground))] tabular-nums in-data-[selected]:text-[color:var(--audio-readout,var(--foreground))] -top-6 absolute left-1/2 -translate-x-1/2 [rotate:calc(var(--knob-mark-angle)*-1)]\"\n      >0</span\n    >\n  </Knob.Mark>\n  <Knob.Mark value={25}>\n    <span\n      class=\"bg-[color:var(--audio-print,color-mix(in_oklab,var(--muted-foreground)_40%,transparent))] transition-colors duration-150 ease-out in-data-[selected]:data-[color]:bg-[color:var(--audio-accent,var(--primary))] motion-reduce:transition-none -top-2.5 absolute left-1/2 h-1.5 w-px -translate-x-1/2\"\n    ></span>\n  </Knob.Mark>\n  <Knob.Mark value={50}>\n    <span\n      class=\"bg-[color:var(--audio-print,color-mix(in_oklab,var(--muted-foreground)_40%,transparent))] transition-colors duration-150 ease-out in-data-[selected]:data-[color]:bg-[color:var(--audio-accent,var(--primary))] motion-reduce:transition-none -top-2.5 absolute left-1/2 h-1.5 w-px -translate-x-1/2\"\n    ></span>\n  </Knob.Mark>\n  <Knob.Mark value={75}>\n    <span\n      class=\"bg-[color:var(--audio-print,color-mix(in_oklab,var(--muted-foreground)_40%,transparent))] transition-colors duration-150 ease-out in-data-[selected]:data-[color]:bg-[color:var(--audio-accent,var(--primary))] motion-reduce:transition-none -top-2.5 absolute left-1/2 h-1.5 w-px -translate-x-1/2\"\n    ></span>\n  </Knob.Mark>\n  <Knob.Mark value={100}>\n    <span\n      class=\"bg-[color:var(--audio-print,color-mix(in_oklab,var(--muted-foreground)_40%,transparent))] transition-colors duration-150 ease-out in-data-[selected]:data-[color]:bg-[color:var(--audio-accent,var(--primary))] motion-reduce:transition-none -top-2.5 absolute left-1/2 h-1.5 w-px -translate-x-1/2\"\n    ></span>\n    <span\n      class=\"text-[10px] leading-none text-[color:var(--audio-print,var(--muted-foreground))] tabular-nums in-data-[selected]:text-[color:var(--audio-readout,var(--foreground))] -top-6 absolute left-1/2 -translate-x-1/2 [rotate:calc(var(--knob-mark-angle)*-1)]\"\n      >100</span\n    >\n  </Knob.Mark>\n  <Knob.Value\n    class=\"rounded-[min(var(--radius-sm),6px)] bg-[color:var(--audio-readout,var(--foreground))] px-1.5 py-0.5 font-medium text-[10px] text-[color:var(--audio-readout-ink,var(--background))] tabular-nums leading-none shadow-sm absolute top-full left-1/2 z-10 mt-6 -translate-x-1/2 cursor-text whitespace-nowrap opacity-0 transition-opacity duration-150 ease-out group-hover/knob:opacity-100 group-has-focus-visible/knob:opacity-100 group-data-dragging/knob:opacity-100 data-editing:opacity-100 motion-reduce:transition-none\"\n    editable\n  />\n</Knob.Root>","path":"knob-demo.svelte","target":"components/examples/knob-demo.svelte","type":"registry:example"}],"name":"knob-svelte-demo","registryDependencies":["@audio-ui/knob-svelte"],"type":"registry:example"}