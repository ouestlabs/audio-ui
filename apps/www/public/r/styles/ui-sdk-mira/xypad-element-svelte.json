{"$schema":"https://ui.shadcn.com/schema/registry-item.json","dependencies":[],"description":"A two-dimensional control for two parameters at once: a pad, its grid, a crosshair, a cursor and a value display. Its svelte component, drawn by the element's sheet.","files":[{"content":"<script lang=\"ts\">\nimport type { ComponentProps } from \"svelte\";\nimport { XYPad } from \"$lib/components/audio-ui/xypad/svelte\";\n\nlet {\n  \"aria-describedby\": describedBy,\n  \"aria-label\": label,\n  \"aria-labelledby\": labelledBy,\n  fill = false,\n  formatValue,\n  size = \"default\",\n  valueDisplay = \"visible\",\n  ...rest\n}: Omit<ComponentProps<typeof XYPad.Root>, \"children\"> & {\n  \"aria-describedby\"?: string;\n  \"aria-label\"?: string;\n  \"aria-labelledby\"?: string;\n  /** Takes the height left in a column in place of its size's, down to a strip: in a short panel it gives way to the controls under it. */\n  fill?: boolean;\n  /** Prints the value in the display, e.g. as `\"440 Hz · 70 %\"`. */\n  formatValue?: (value: { x: number; y: number }) => string;\n  size?: \"sm\" | \"default\" | \"lg\" | \"xl\";\n  valueDisplay?: \"visible\" | \"hidden\";\n} = $props();\n\nconst LINES = [20, 40, 60, 80];\n</script>\n\n<XYPad.Root {...rest} data-fill={fill ? \"\" : undefined} data-size={size}>\n  <XYPad.Control>\n    <div aria-hidden=\"true\" data-slot=\"xypad-grid\">\n      {#each LINES as position (`vertical-${position}`)}\n        <div\n          data-orientation=\"vertical\"\n          data-slot=\"xypad-grid-line\"\n          style:left=\"{position}%\"\n        ></div>\n      {/each}\n      {#each LINES as position (`horizontal-${position}`)}\n        <div\n          data-orientation=\"horizontal\"\n          data-slot=\"xypad-grid-line\"\n          style:top=\"{position}%\"\n        ></div>\n      {/each}\n    </div>\n    <div\n      aria-hidden=\"true\"\n      data-orientation=\"vertical\"\n      data-slot=\"xypad-crosshair\"\n    ></div>\n    <div\n      aria-hidden=\"true\"\n      data-orientation=\"horizontal\"\n      data-slot=\"xypad-crosshair\"\n    ></div>\n    <XYPad.Thumb\n      aria-describedby={describedBy}\n      aria-label={label}\n      aria-labelledby={labelledBy}\n    >\n      <div data-slot=\"xypad-cursor-glow\"></div>\n      <div data-slot=\"xypad-cursor-dot\"></div>\n      <div data-slot=\"xypad-cursor-highlight\"></div>\n    </XYPad.Thumb>\n    {#if valueDisplay === \"visible\"}\n      {#if formatValue}\n        <XYPad.Value>\n          {#snippet children(\n            state\n          )}\n            {formatValue(state.value)}\n          {/snippet}\n        </XYPad.Value>\n      {:else}\n        <XYPad.Value />\n      {/if}\n    {/if}\n  </XYPad.Control>\n</XYPad.Root>","path":"XYPad.svelte","target":"~/src/lib/components/audio-ui/xypad/XYPad.svelte","type":"registry:component"}],"name":"xypad-element-svelte","registryDependencies":["@audio-ui/xypad-svelte"],"type":"registry:component"}