{"$schema":"https://ui.shadcn.com/schema/registry-item.json","description":"fader example, in the Vue adapter","files":[{"content":"<script lang=\"ts\" setup>\nimport { Fader } from \"@/components/audio-ui/fader/vue\";\n</script>\n\n<template>\n  <Fader.Root\n    class=\"group/fader relative data-[orientation=vertical]:h-full data-[orientation=horizontal]:w-full data-disabled:cursor-not-allowed data-[orientation=horizontal]:pb-6 data-[orientation=vertical]:ps-10\"\n    orientation=\"vertical\"\n    :default-value=\"50\"\n    :max=\"100\"\n    :min=\"0\"\n    :step=\"1\"\n  >\n    <Fader.Control\n      class=\"relative flex w-full touch-none select-none items-center data-[orientation=vertical]:h-full data-[orientation=vertical]:min-h-[var(--fader-min-height,10rem)] data-[orientation=vertical]:w-auto data-[orientation=vertical]:flex-col data-[orientation=horizontal]:w-full data-[orientation=horizontal]:min-w-32 transition-opacity duration-150 ease-out motion-reduce:transition-none data-disabled:pointer-events-none data-disabled:opacity-50\"\n    >\n      <Fader.Track\n        class=\"rounded-full bg-[color:var(--audio-groove,color-mix(in_oklab,var(--input)_90%,transparent))] data-[orientation=horizontal]:h-2 data-[orientation=vertical]:h-full data-[orientation=horizontal]:w-full data-[orientation=vertical]:w-2 relative grow cursor-pointer select-none overflow-hidden\"\n      >\n        <Fader.Indicator\n          class=\"bg-[color:var(--audio-accent,var(--primary))] absolute select-none data-[orientation=horizontal]:h-full data-[orientation=vertical]:w-full data-[orientation=vertical]:bottom-0\"\n        />\n      </Fader.Track>\n      <div\n        aria-hidden=\"true\"\n        class=\"pointer-events-none absolute inset-y-0 end-[calc(50%+0.75rem)]\"\n      >\n        <Fader.Mark\n          class=\"flex items-center gap-1 end-0 translate-y-1/2 flex-row\"\n          :value=\"0\"\n        >\n          <span class=\"text-[10px] leading-none text-[color:var(--audio-print,var(--muted-foreground))] tabular-nums in-data-[active]:text-[color:var(--audio-readout,var(--foreground))]\">0</span>\n          <span class=\"bg-[color:var(--audio-print,color-mix(in_oklab,var(--muted-foreground)_40%,transparent))] transition-colors duration-150 ease-out in-data-[active]:data-[color]:bg-[color:var(--audio-accent,var(--primary))] motion-reduce:transition-none h-px w-1.5\" />\n        </Fader.Mark>\n        <Fader.Mark\n          class=\"flex items-center gap-1 end-0 translate-y-1/2 flex-row\"\n          :value=\"25\"\n        >\n          <span class=\"bg-[color:var(--audio-print,color-mix(in_oklab,var(--muted-foreground)_40%,transparent))] transition-colors duration-150 ease-out in-data-[active]:data-[color]:bg-[color:var(--audio-accent,var(--primary))] motion-reduce:transition-none h-px w-1.5\" />\n        </Fader.Mark>\n        <Fader.Mark\n          class=\"flex items-center gap-1 end-0 translate-y-1/2 flex-row\"\n          :value=\"50\"\n        >\n          <span class=\"bg-[color:var(--audio-print,color-mix(in_oklab,var(--muted-foreground)_40%,transparent))] transition-colors duration-150 ease-out in-data-[active]:data-[color]:bg-[color:var(--audio-accent,var(--primary))] motion-reduce:transition-none h-px w-1.5\" />\n        </Fader.Mark>\n        <Fader.Mark\n          class=\"flex items-center gap-1 end-0 translate-y-1/2 flex-row\"\n          :value=\"75\"\n        >\n          <span class=\"bg-[color:var(--audio-print,color-mix(in_oklab,var(--muted-foreground)_40%,transparent))] transition-colors duration-150 ease-out in-data-[active]:data-[color]:bg-[color:var(--audio-accent,var(--primary))] motion-reduce:transition-none h-px w-1.5\" />\n        </Fader.Mark>\n        <Fader.Mark\n          class=\"flex items-center gap-1 end-0 translate-y-1/2 flex-row\"\n          :value=\"100\"\n        >\n          <span class=\"text-[10px] leading-none text-[color:var(--audio-print,var(--muted-foreground))] tabular-nums in-data-[active]:text-[color:var(--audio-readout,var(--foreground))]\">100</span>\n          <span class=\"bg-[color:var(--audio-print,color-mix(in_oklab,var(--muted-foreground)_40%,transparent))] transition-colors duration-150 ease-out in-data-[active]:data-[color]:bg-[color:var(--audio-accent,var(--primary))] motion-reduce:transition-none h-px w-1.5\" />\n        </Fader.Mark>\n      </div>\n      <Fader.Thumb\n        aria-label=\"Volume\"\n        class=\"bg-[color:var(--audio-cap,var(--card))] shadow-md ring-1 ring-foreground/10 transition-[color,box-shadow] hover:ring-2 hover:ring-ring/30 has-focus-visible:ring-4 has-focus-visible:ring-ring/30 active:ring-4 active:ring-ring/30 motion-reduce:transition-none rounded-[min(var(--radius-md),10px)] data-[orientation=horizontal]:h-4 data-[orientation=vertical]:h-6 data-[orientation=horizontal]:w-6 data-[orientation=vertical]:w-4 before:-inset-2 absolute z-10 block shrink-0 cursor-grab select-none outline-none before:absolute before:content-[''] active:cursor-grabbing data-disabled:pointer-events-none\"\n      >\n        <div\n          class=\"data-[orientation=horizontal]:px-1.5 data-[orientation=horizontal]:py-1 data-[orientation=vertical]:px-1 data-[orientation=vertical]:py-1.5 flex h-full w-full items-center justify-center gap-0.5 data-[orientation=horizontal]:flex-row data-[orientation=vertical]:flex-col\"\n          data-orientation=\"vertical\"\n        >\n          <div\n            class=\"bg-[color:var(--audio-accent,var(--primary))] opacity-50 data-[orientation=horizontal]:h-2.5 data-[orientation=vertical]:h-px data-[orientation=horizontal]:w-px data-[orientation=vertical]:w-2.5\"\n            data-orientation=\"vertical\"\n          />\n          <div\n            class=\"bg-[color:var(--audio-accent,var(--primary))] opacity-50 data-[orientation=horizontal]:h-2.5 data-[orientation=vertical]:h-px data-[orientation=horizontal]:w-px data-[orientation=vertical]:w-2.5\"\n            data-orientation=\"vertical\"\n          />\n          <div\n            class=\"bg-[color:var(--audio-accent,var(--primary))] opacity-50 data-[orientation=horizontal]:h-2.5 data-[orientation=vertical]:h-px data-[orientation=horizontal]:w-px data-[orientation=vertical]:w-2.5\"\n            data-orientation=\"vertical\"\n          />\n        </div>\n        <Fader.Value\n          class=\"rounded-[min(var(--radius-sm),6px)] bg-[color:var(--audio-readout,var(--foreground))] px-1.5 py-0.5 font-medium text-[10px] text-[color:var(--audio-readout-ink,var(--background))] tabular-nums leading-none shadow-sm absolute z-20 whitespace-nowrap cursor-text start-full top-1/2 ms-2 -translate-y-1/2 opacity-0 transition-opacity duration-150 ease-out group-hover/fader:opacity-100 group-has-focus-visible/fader:opacity-100 group-has-data-dragging/fader:opacity-100 data-editing:opacity-100 motion-reduce:transition-none\"\n          editable\n        />\n      </Fader.Thumb>\n    </Fader.Control>\n  </Fader.Root>\n</template>","path":"fader-demo.vue","target":"components/examples/fader-demo.vue","type":"registry:example"}],"name":"fader-vue-demo","registryDependencies":["@audio-ui/fader-vue"],"type":"registry:example"}