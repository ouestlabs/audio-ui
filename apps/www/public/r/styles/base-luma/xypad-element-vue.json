{"$schema":"https://ui.shadcn.com/schema/registry-item.json","dependencies":[],"description":"A two-dimensional control for two parameters at once: a pad, its grid, a crosshair, a cursor and a value display. Its vue component, drawn by the element's sheet.","files":[{"content":"<script lang=\"ts\" setup>\nimport { XYPad } from \"@/components/audio-ui/xypad/vue\";\n\nwithDefaults(\n  defineProps<{\n    /** Takes the height left in a column in place of its size's, down to a strip: in a short panel it gives way to the controls under it. */\n    fill?: boolean;\n    /** Prints the value in the display, e.g. as `\"440 Hz · 70 %\"`. */\n    formatValue?: (value: { x: number; y: number }) => string;\n    size?: \"sm\" | \"default\" | \"lg\" | \"xl\";\n    valueDisplay?: \"visible\" | \"hidden\";\n  }>(),\n  { fill: false, size: \"default\", valueDisplay: \"visible\" }\n);\n\ndefineOptions({ inheritAttrs: false });\n\n// The pad's options go to its root, its name to the thumb's inputs.\nconst forRoot = ({\n  \"aria-describedby\": _describedBy,\n  \"aria-label\": _label,\n  \"aria-labelledby\": _labelledBy,\n  ...rest\n}: Record<string, unknown>) => rest;\n\nconst LINES = [20, 40, 60, 80];\n</script>\n\n<template>\n  <XYPad.Root\n    v-bind=\"forRoot($attrs)\"\n    :data-fill=\"fill ? '' : undefined\"\n    :data-size=\"size\"\n  >\n    <XYPad.Control>\n      <div aria-hidden=\"true\" data-slot=\"xypad-grid\">\n        <div\n          data-orientation=\"vertical\"\n          data-slot=\"xypad-grid-line\"\n          v-for=\"position in LINES\"\n          :key=\"`vertical-${position}`\"\n          :style=\"{ left: `${position}%` }\"\n        />\n        <div\n          data-orientation=\"horizontal\"\n          data-slot=\"xypad-grid-line\"\n          v-for=\"position in LINES\"\n          :key=\"`horizontal-${position}`\"\n          :style=\"{ top: `${position}%` }\"\n        />\n      </div>\n      <div\n        aria-hidden=\"true\"\n        data-orientation=\"vertical\"\n        data-slot=\"xypad-crosshair\"\n      />\n      <div\n        aria-hidden=\"true\"\n        data-orientation=\"horizontal\"\n        data-slot=\"xypad-crosshair\"\n      />\n      <XYPad.Thumb\n        :aria-describedby=\"$attrs['aria-describedby']\"\n        :aria-label=\"$attrs['aria-label']\"\n        :aria-labelledby=\"$attrs['aria-labelledby']\"\n      >\n        <div data-slot=\"xypad-cursor-glow\" />\n        <div data-slot=\"xypad-cursor-dot\" />\n        <div data-slot=\"xypad-cursor-highlight\" />\n      </XYPad.Thumb>\n      <XYPad.Value v-if=\"valueDisplay === 'visible'\">\n        <template v-if=\"formatValue\" #default=\"{ state }\">{{\n          formatValue(state.value)\n        }}</template>\n      </XYPad.Value>\n    </XYPad.Control>\n  </XYPad.Root>\n</template>","path":"XYPad.vue","target":"components/audio-ui/xypad/XYPad.vue","type":"registry:ui"}],"name":"xypad-element-vue","registryDependencies":["@audio-ui/xypad-vue"],"type":"registry:ui"}