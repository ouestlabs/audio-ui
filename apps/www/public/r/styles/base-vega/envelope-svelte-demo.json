{"$schema":"https://ui.shadcn.com/schema/registry-item.json","description":"envelope example, in the Svelte adapter","files":[{"content":"<script lang=\"ts\">\nimport { Envelope } from \"$lib/components/audio-ui/envelope/svelte\";\n\nlet points = $state([\n  { x: 0, y: 0 },\n  { x: 0.15, y: 1 },\n  { x: 0.6, y: 0.5 },\n  { x: 1, y: 0 },\n]);\n\nconst describe = (point: { x: number; y: number }) =>\n  `${Math.round(point.x * 100)}% · ${Math.round(point.y * 100)}%`;\n</script>\n\n<div\n  class=\"rounded-xl border border-transparent bg-card shadow-xs ring-1 ring-foreground/10 transition-[color,border-color,box-shadow,opacity] duration-150 ease-out hover:ring-4 hover:ring-ring/50 has-[:focus-visible]:ring-4 has-[:focus-visible]:ring-ring/50 active:ring-4 active:ring-ring/50 has-[:focus-visible]:border-ring active:border-ring motion-reduce:transition-none data-blocked:animate-[envelope-shake_280ms_linear] motion-reduce:data-blocked:animate-none [&_svg[data-blocked]]:animate-[envelope-shake_280ms_linear] motion-reduce:[&_svg[data-blocked]]:animate-none h-48 group/envelope box-border w-full cursor-crosshair touch-none select-none p-3.5 has-data-disabled:pointer-events-none has-data-disabled:opacity-50\"\n>\n  <Envelope.Root\n    aria-label=\"Envelope\"\n    class=\"size-full data-disabled:cursor-not-allowed\"\n    onValueChange={(next) => {\n      points = next;\n    }}\n    role=\"group\"\n    value={points}\n  >\n    {#snippet children(\n      state\n    )}\n      <Envelope.Graph class=\"size-full overflow-visible\">\n        <Envelope.Fill class=\"fill-primary/15 stroke-none\" />\n        <Envelope.Line class=\"stroke-primary stroke-2 [stroke-linejoin:round]\" />\n      </Envelope.Graph>\n      {#each state.value.slice(0, -1) as _, index (index)}\n        <Envelope.Segment\n          aria-label={`Curve ${index + 1}`}\n          class=\"size-3 rounded-full border border-primary bg-background shadow-xs transition-[box-shadow,opacity] hover:ring-4 hover:ring-ring/30 focus-visible:ring-3 focus-visible:ring-ring/50 data-dragging:ring-4 data-dragging:ring-ring/30 data-flat:hidden motion-reduce:transition-none group/segment cursor-ns-resize opacity-0 outline-none after:absolute after:-inset-2 pointer-coarse:opacity-100 pointer-coarse:after:-inset-4 group-focus-within/envelope:opacity-100 group-hover/envelope:opacity-100 data-dragging:opacity-100\"\n          {index}\n        />\n      {/each}\n      {#each state.value as point, index (index)}\n        <Envelope.Point\n          aria-label={`Point ${index + 1} of ${state.value.length}`}\n          class=\"rounded-full border-2 border-primary bg-background shadow-xs data-active:bg-primary transition-[box-shadow] duration-150 ease-out hover:ring-4 hover:ring-ring/30 focus-within:ring-3 focus-within:ring-ring/50 data-dragging:ring-4 data-dragging:ring-ring/30 motion-reduce:transition-none data-blocked:animate-[envelope-shake_280ms_linear] motion-reduce:data-blocked:animate-none group/point size-4 cursor-grab data-dragging:bg-primary focus-visible:bg-primary touch-none select-none outline-none after:absolute after:-inset-2 pointer-coarse:after:-inset-3.5 active:cursor-grabbing\"\n          getAriaValueText={describe}\n          {index}\n        >\n          <span\n            aria-hidden=\"true\"\n            class=\"rounded-full bg-popover px-1.5 py-0.5 font-mono text-[10px] text-popover-foreground shadow-md ring-1 ring-foreground/10 -translate-x-1/2 pointer-events-none absolute left-1/2 z-10 hidden whitespace-nowrap group-hover/point:block group-data-dragging/point:block group-focus-visible/point:block bottom-full mb-2\"\n            >{describe(point)}</span\n          >\n        </Envelope.Point>\n      {/each}\n    {/snippet}\n  </Envelope.Root>\n</div>","path":"envelope-demo.svelte","target":"components/examples/envelope-demo.svelte","type":"registry:example"}],"name":"envelope-svelte-demo","registryDependencies":["@audio-ui/envelope-svelte"],"type":"registry:example"}