{"$schema":"https://ui.shadcn.com/schema/registry-item.json","dependencies":[],"description":"A level meter: a channel per level, its fill, a held peak and a scale in dB. Its svelte component, drawn by the element's sheet.","files":[{"content":"<script lang=\"ts\">\nimport type { ComponentProps } from \"svelte\";\nimport { Meter } from \"$lib/components/audio-ui/meter/svelte\";\n\nlet {\n  \"aria-label\": label,\n  marks,\n  orientation = \"vertical\",\n  peakMarks = \"visible\",\n  scale = \"iec\",\n  size = \"default\",\n  ...rest\n}: Omit<ComponentProps<typeof Meter.Root>, \"children\"> & {\n  \"aria-label\"?: string;\n  /** Levels graduated along the meter's length, such as `[-48, -24, -12, -6, 0]`, each with its label. */\n  marks?: readonly number[];\n  orientation?: \"horizontal\" | \"vertical\";\n  peakMarks?: \"visible\" | \"hidden\";\n  size?: \"sm\" | \"default\" | \"lg\";\n} = $props();\n\nconst decibels = (formattedValue: string) => `${formattedValue} dB`;\n\n// Each channel is named after the meter, and numbered when there are several.\nconst channelLabel = (index: number, count: number) =>\n  label && count > 1 ? `${label} ${index + 1}` : label;\n</script>\n\n<Meter.Root\n  {...rest}\n  aria-label={label}\n  data-marks={marks ? \"labels\" : undefined}\n  data-size={size}\n  {orientation}\n  {scale}\n>\n  {#snippet children(\n    state\n  )}\n    {#each Array.from(\n      { length: state.channelCount },\n      (_, index) => index\n    ) as index (index)}\n      <Meter.Channel\n        aria-label={channelLabel(index, state.channelCount)}\n        getAriaValueText={decibels}\n        {index}\n      >\n        <Meter.Indicator />\n        {#if peakMarks === \"visible\"}\n          <Meter.Peak />\n        {/if}\n      </Meter.Channel>\n    {/each}\n    {#each marks ?? [] as level (level)}\n      <Meter.Mark value={level}>\n        <span\n          aria-hidden=\"true\"\n          data-orientation={orientation}\n          data-slot=\"meter-mark-tick\"\n        ></span>\n        <span data-slot=\"meter-mark-label\">{level}</span>\n      </Meter.Mark>\n    {/each}\n  {/snippet}\n</Meter.Root>","path":"Meter.svelte","target":"~/src/lib/components/audio-ui/meter/Meter.svelte","type":"registry:component"}],"name":"meter-element-svelte","registryDependencies":["@audio-ui/meter-svelte"],"type":"registry:component"}