{"$schema":"https://ui.shadcn.com/schema/registry-item.json","description":"meter example, in the web adapter","files":[{"content":"import \"@/components/audio-ui/meter/web\";\nimport { createSimulatedLevels } from \"@/lib/simulated-levels\";\n\n/** Draws the meter into `element`, and returns what takes it away. */\nexport function meterWebDemo(element) {\n  element.innerHTML = `\n    <audio-ui-meter aria-label=\"Stereo output\" class=\"relative data-[orientation=vertical]:h-48 data-[orientation=vertical]:[--meter-thickness:--spacing(3.5)] data-[orientation=horizontal]:[--meter-thickness:--spacing(3)] flex select-none gap-1 data-[orientation=horizontal]:mb-6 data-[orientation=horizontal]:w-full data-[orientation=horizontal]:flex-col data-[orientation=vertical]:me-8 data-[orientation=vertical]:w-fit\" warn-threshold=\"-12\">\n      <audio-ui-meter-channel aria-label=\"Stereo output 1\" class=\"rounded-none bg-[color:var(--audio-groove,color-mix(in_oklab,var(--input)_70%,transparent))] transition-shadow duration-150 ease-out data-clipping:ring-2 data-clipped:ring-2 data-clipping:ring-destructive data-clipped:ring-destructive relative flex-1 overflow-hidden data-[orientation=horizontal]:h-(--meter-thickness,auto) data-[orientation=horizontal]:flex-none data-[orientation=vertical]:w-(--meter-thickness,auto) data-[orientation=vertical]:flex-none\" index=\"0\">\n        <audio-ui-meter-indicator class=\"bg-[color:var(--audio-level,var(--success))] data-warning:bg-[color:var(--audio-warn,var(--warning))] data-clipping:bg-[color:var(--audio-clip,var(--destructive))] data-clipped:bg-[color:var(--audio-clip,var(--destructive))] absolute inset-0\"></audio-ui-meter-indicator>\n        <audio-ui-meter-peak class=\"bg-[color:var(--audio-readout,var(--foreground))] absolute data-[orientation=horizontal]:top-0 data-[orientation=horizontal]:bottom-0 data-[orientation=horizontal]:w-0.5 data-[orientation=vertical]:right-0 data-[orientation=vertical]:left-0 data-[orientation=vertical]:h-0.5\"></audio-ui-meter-peak>\n      </audio-ui-meter-channel>\n      <audio-ui-meter-channel aria-label=\"Stereo output 2\" class=\"rounded-none bg-[color:var(--audio-groove,color-mix(in_oklab,var(--input)_70%,transparent))] transition-shadow duration-150 ease-out data-clipping:ring-2 data-clipped:ring-2 data-clipping:ring-destructive data-clipped:ring-destructive relative flex-1 overflow-hidden data-[orientation=horizontal]:h-(--meter-thickness,auto) data-[orientation=horizontal]:flex-none data-[orientation=vertical]:w-(--meter-thickness,auto) data-[orientation=vertical]:flex-none\" index=\"1\">\n        <audio-ui-meter-indicator class=\"bg-[color:var(--audio-level,var(--success))] data-warning:bg-[color:var(--audio-warn,var(--warning))] data-clipping:bg-[color:var(--audio-clip,var(--destructive))] data-clipped:bg-[color:var(--audio-clip,var(--destructive))] absolute inset-0\"></audio-ui-meter-indicator>\n        <audio-ui-meter-peak class=\"bg-[color:var(--audio-readout,var(--foreground))] absolute data-[orientation=horizontal]:top-0 data-[orientation=horizontal]:bottom-0 data-[orientation=horizontal]:w-0.5 data-[orientation=vertical]:right-0 data-[orientation=vertical]:left-0 data-[orientation=vertical]:h-0.5\"></audio-ui-meter-peak>\n      </audio-ui-meter-channel>\n      <audio-ui-meter-mark class=\"text-[color:var(--audio-print,var(--muted-foreground))] flex items-center gap-1 text-[10px] tabular-nums data-[orientation=vertical]:left-full data-[orientation=vertical]:ms-1 data-[orientation=horizontal]:top-full data-[orientation=horizontal]:mt-1 data-[orientation=horizontal]:-translate-x-1/2 data-[orientation=vertical]:translate-y-1/2 data-[orientation=horizontal]:flex-col\" value=\"6\">\n        <span aria-hidden=\"true\" class=\"bg-current opacity-40 data-[orientation=horizontal]:h-1 data-[orientation=horizontal]:w-px data-[orientation=vertical]:h-px data-[orientation=vertical]:w-1.5\" data-orientation=\"vertical\"></span>\n        <span class=\"min-w-4 text-end data-[orientation=horizontal]:text-center\">6</span>\n      </audio-ui-meter-mark>\n      <audio-ui-meter-mark class=\"text-[color:var(--audio-print,var(--muted-foreground))] flex items-center gap-1 text-[10px] tabular-nums data-[orientation=vertical]:left-full data-[orientation=vertical]:ms-1 data-[orientation=horizontal]:top-full data-[orientation=horizontal]:mt-1 data-[orientation=horizontal]:-translate-x-1/2 data-[orientation=vertical]:translate-y-1/2 data-[orientation=horizontal]:flex-col\" value=\"0\">\n        <span aria-hidden=\"true\" class=\"bg-current opacity-40 data-[orientation=horizontal]:h-1 data-[orientation=horizontal]:w-px data-[orientation=vertical]:h-px data-[orientation=vertical]:w-1.5\" data-orientation=\"vertical\"></span>\n        <span class=\"min-w-4 text-end data-[orientation=horizontal]:text-center\">0</span>\n      </audio-ui-meter-mark>\n      <audio-ui-meter-mark class=\"text-[color:var(--audio-print,var(--muted-foreground))] flex items-center gap-1 text-[10px] tabular-nums data-[orientation=vertical]:left-full data-[orientation=vertical]:ms-1 data-[orientation=horizontal]:top-full data-[orientation=horizontal]:mt-1 data-[orientation=horizontal]:-translate-x-1/2 data-[orientation=vertical]:translate-y-1/2 data-[orientation=horizontal]:flex-col\" value=\"-6\">\n        <span aria-hidden=\"true\" class=\"bg-current opacity-40 data-[orientation=horizontal]:h-1 data-[orientation=horizontal]:w-px data-[orientation=vertical]:h-px data-[orientation=vertical]:w-1.5\" data-orientation=\"vertical\"></span>\n        <span class=\"min-w-4 text-end data-[orientation=horizontal]:text-center\">-6</span>\n      </audio-ui-meter-mark>\n      <audio-ui-meter-mark class=\"text-[color:var(--audio-print,var(--muted-foreground))] flex items-center gap-1 text-[10px] tabular-nums data-[orientation=vertical]:left-full data-[orientation=vertical]:ms-1 data-[orientation=horizontal]:top-full data-[orientation=horizontal]:mt-1 data-[orientation=horizontal]:-translate-x-1/2 data-[orientation=vertical]:translate-y-1/2 data-[orientation=horizontal]:flex-col\" value=\"-12\">\n        <span aria-hidden=\"true\" class=\"bg-current opacity-40 data-[orientation=horizontal]:h-1 data-[orientation=horizontal]:w-px data-[orientation=vertical]:h-px data-[orientation=vertical]:w-1.5\" data-orientation=\"vertical\"></span>\n        <span class=\"min-w-4 text-end data-[orientation=horizontal]:text-center\">-12</span>\n      </audio-ui-meter-mark>\n      <audio-ui-meter-mark class=\"text-[color:var(--audio-print,var(--muted-foreground))] flex items-center gap-1 text-[10px] tabular-nums data-[orientation=vertical]:left-full data-[orientation=vertical]:ms-1 data-[orientation=horizontal]:top-full data-[orientation=horizontal]:mt-1 data-[orientation=horizontal]:-translate-x-1/2 data-[orientation=vertical]:translate-y-1/2 data-[orientation=horizontal]:flex-col\" value=\"-20\">\n        <span aria-hidden=\"true\" class=\"bg-current opacity-40 data-[orientation=horizontal]:h-1 data-[orientation=horizontal]:w-px data-[orientation=vertical]:h-px data-[orientation=vertical]:w-1.5\" data-orientation=\"vertical\"></span>\n        <span class=\"min-w-4 text-end data-[orientation=horizontal]:text-center\">-20</span>\n      </audio-ui-meter-mark>\n      <audio-ui-meter-mark class=\"text-[color:var(--audio-print,var(--muted-foreground))] flex items-center gap-1 text-[10px] tabular-nums data-[orientation=vertical]:left-full data-[orientation=vertical]:ms-1 data-[orientation=horizontal]:top-full data-[orientation=horizontal]:mt-1 data-[orientation=horizontal]:-translate-x-1/2 data-[orientation=vertical]:translate-y-1/2 data-[orientation=horizontal]:flex-col\" value=\"-30\">\n        <span aria-hidden=\"true\" class=\"bg-current opacity-40 data-[orientation=horizontal]:h-1 data-[orientation=horizontal]:w-px data-[orientation=vertical]:h-px data-[orientation=vertical]:w-1.5\" data-orientation=\"vertical\"></span>\n        <span class=\"min-w-4 text-end data-[orientation=horizontal]:text-center\">-30</span>\n      </audio-ui-meter-mark>\n      <audio-ui-meter-mark class=\"text-[color:var(--audio-print,var(--muted-foreground))] flex items-center gap-1 text-[10px] tabular-nums data-[orientation=vertical]:left-full data-[orientation=vertical]:ms-1 data-[orientation=horizontal]:top-full data-[orientation=horizontal]:mt-1 data-[orientation=horizontal]:-translate-x-1/2 data-[orientation=vertical]:translate-y-1/2 data-[orientation=horizontal]:flex-col\" value=\"-40\">\n        <span aria-hidden=\"true\" class=\"bg-current opacity-40 data-[orientation=horizontal]:h-1 data-[orientation=horizontal]:w-px data-[orientation=vertical]:h-px data-[orientation=vertical]:w-1.5\" data-orientation=\"vertical\"></span>\n        <span class=\"min-w-4 text-end data-[orientation=horizontal]:text-center\">-40</span>\n      </audio-ui-meter-mark>\n      <audio-ui-meter-mark class=\"text-[color:var(--audio-print,var(--muted-foreground))] flex items-center gap-1 text-[10px] tabular-nums data-[orientation=vertical]:left-full data-[orientation=vertical]:ms-1 data-[orientation=horizontal]:top-full data-[orientation=horizontal]:mt-1 data-[orientation=horizontal]:-translate-x-1/2 data-[orientation=vertical]:translate-y-1/2 data-[orientation=horizontal]:flex-col\" value=\"-60\">\n        <span aria-hidden=\"true\" class=\"bg-current opacity-40 data-[orientation=horizontal]:h-1 data-[orientation=horizontal]:w-px data-[orientation=vertical]:h-px data-[orientation=vertical]:w-1.5\" data-orientation=\"vertical\"></span>\n        <span class=\"min-w-4 text-end data-[orientation=horizontal]:text-center\">-60</span>\n      </audio-ui-meter-mark>\n    </audio-ui-meter>`;\n  const simulated = createSimulatedLevels(2);\n  const meter = element.querySelector(\"audio-ui-meter\");\n  if (meter) {\n    meter.source = simulated.source;\n  }\n  const stop = simulated.run();\n  return () => {\n    stop();\n    element.innerHTML = \"\";\n  };\n}","path":"meter-demo.js","target":"components/examples/meter-demo.js","type":"registry:example"}],"name":"meter-web-demo","registryDependencies":["@audio-ui/meter-web","@audio-ui/simulated-levels"],"type":"registry:example"}