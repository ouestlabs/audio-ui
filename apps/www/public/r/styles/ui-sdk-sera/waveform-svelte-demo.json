{"$schema":"https://ui.shadcn.com/schema/registry-item.json","description":"waveform example, in the Svelte adapter","files":[{"content":"<script lang=\"ts\">\nimport { Waveform } from \"$lib/components/audio-ui/waveform/svelte\";\n\nconst DURATION_SECONDS = 180;\n\n// Stand-in for the peaks of a decoded audio file.\nconst PEAKS = Array.from({ length: 512 }, (_, index) => {\n  const time = index / 512;\n  const section =\n    0.5 + 0.28 * Math.sin(time * 11 + 0.8) + 0.18 * Math.sin(time * 29);\n  const beat = 0.7 + 0.3 * Math.abs(Math.cos(index * 0.26));\n  const grain = Math.abs((Math.sin(index * 12.9898) * 43_758.5453) % 1);\n  const level = section * beat * (0.45 + 0.55 * grain) + 0.04;\n  return Math.round(Math.min(1, level) * 1000) / 1000;\n});\n\nfunction formatTime(seconds: number): string {\n  const whole = Math.floor(seconds);\n  return `${Math.floor(whole / 60)}:${String(whole % 60).padStart(2, \"0\")}`;\n}\n\nconst describePosition = (value: number, duration: number) =>\n  `${formatTime(value)} of ${formatTime(duration)}`;\n\nlet loop = $state<readonly [number, number]>([48, 96]);\n</script>\n\n<div class=\"flex w-full min-w-0 flex-col gap-2\">\n  <Waveform.Root\n    class=\"group/waveform w-full min-w-0 data-disabled:cursor-not-allowed\"\n    defaultValue={30}\n    duration={DURATION_SECONDS}\n    peaks={PEAKS}\n  >\n    <Waveform.Control\n      aria-label=\"Track progress\"\n      class=\"relative h-20 rounded-none relative w-full min-w-0 cursor-pointer touch-none select-none overflow-hidden py-1 has-focus-visible:ring-3 has-focus-visible:ring-ring/50 data-disabled:pointer-events-none data-disabled:opacity-50 data-loading:cursor-progress\"\n      getAriaValueText={describePosition}\n    >\n      <Waveform.Canvas\n        class=\"pointer-events-none [--waveform-bar-radius:max(0px,min(var(--radius-sm),3px))] [--waveform-color:color-mix(in_oklab,var(--muted-foreground)_50%,transparent)] [--waveform-progress-color:var(--primary)] block size-full [-webkit-mask-image:linear-gradient(to_right,transparent,black_16px,black_calc(100%-16px),transparent)] mask-[linear-gradient(to_right,transparent,black_16px,black_calc(100%-16px),transparent)]\"\n      />\n      <Waveform.Region\n        class=\"rounded-[min(var(--radius-sm),6px)] bg-primary/15 ring-1 ring-primary/40 ring-inset pointer-events-none inset-y-0\"\n        onValueChange={(next) => {\n          loop = next;\n        }}\n        region=\"loop\"\n        value={loop}\n      >\n        <Waveform.RegionHandle\n          aria-label=\"Loop start\"\n          class=\"rounded-[min(var(--radius-sm),6px)] bg-primary/60 has-focus-visible:bg-primary has-focus-visible:ring-3 has-focus-visible:ring-ring/50 pointer-events-auto absolute inset-y-0 w-1.5 cursor-ew-resize data-[edge=end]:right-0 data-[edge=start]:left-0 after:absolute after:-inset-x-1.5 after:inset-y-0 pointer-coarse:after:-inset-x-3\"\n          edge=\"start\"\n          getAriaValueText={formatTime}\n          region=\"loop\"\n        />\n        <Waveform.RegionHandle\n          aria-label=\"Loop end\"\n          class=\"rounded-[min(var(--radius-sm),6px)] bg-primary/60 has-focus-visible:bg-primary has-focus-visible:ring-3 has-focus-visible:ring-ring/50 pointer-events-auto absolute inset-y-0 w-1.5 cursor-ew-resize data-[edge=end]:right-0 data-[edge=start]:left-0 after:absolute after:-inset-x-1.5 after:inset-y-0 pointer-coarse:after:-inset-x-3\"\n          edge=\"end\"\n          getAriaValueText={formatTime}\n          region=\"loop\"\n        />\n      </Waveform.Region>\n      <Waveform.Marker\n        class=\"bg-foreground/50 pointer-events-none inset-y-0 w-px\"\n        value={20}\n      >\n        <span\n          class=\"rounded-[min(var(--radius-sm),6px)] bg-muted px-1 font-medium text-[0.625rem] text-foreground absolute top-0 left-1 whitespace-nowrap\"\n          >Verse</span\n        >\n      </Waveform.Marker>\n      <Waveform.Marker\n        class=\"bg-foreground/50 pointer-events-none inset-y-0 w-px\"\n        value={124}\n      >\n        <span\n          class=\"rounded-[min(var(--radius-sm),6px)] bg-muted px-1 font-medium text-[0.625rem] text-foreground absolute top-0 left-1 whitespace-nowrap\"\n          >Chorus</span\n        >\n      </Waveform.Marker>\n      <Waveform.Hover\n        class=\"bg-foreground/40 pointer-events-none inset-y-0 z-10 w-px indent-1 whitespace-nowrap\"\n        format={formatTime}\n      />\n      <Waveform.Playhead\n        class=\"inset-y-0 w-0.5 -translate-x-1/2 bg-primary group-data-outside/waveform:hidden\"\n      />\n      <Waveform.Thumb\n        class=\"inset-y-0 my-auto size-3.5 rounded-sm border-2 border-background bg-primary shadow-md group-data-outside/waveform:hidden\"\n      />\n    </Waveform.Control>\n  </Waveform.Root>\n  <p class=\"text-muted-foreground text-sm tabular-nums\">\n    Loop {formatTime(loop[0])} – {formatTime(loop[1])}\n  </p>\n</div>","path":"waveform-demo.svelte","target":"components/examples/waveform-demo.svelte","type":"registry:example"}],"name":"waveform-svelte-demo","registryDependencies":["@audio-ui/waveform-svelte"],"type":"registry:example"}