{"$schema":"https://ui.shadcn.com/schema/registry-item.json","description":"plot example, in the Svelte adapter","files":[{"content":"<script lang=\"ts\">\nimport { Plot } from \"$lib/components/audio-ui/plot/svelte\";\n\nlet peak = $state({ x: 1000, y: 6 });\nconst response = (hz: number, point: { x: number; y: number }) =>\n  point.y * Math.exp(-(Math.log2(hz / point.x) ** 2));\nconst curve = (hz: number) => response(hz, peak);\n</script>\n\n<Plot.Root\n  class=\"rounded-xl border bg-card relative h-48 w-full touch-none select-none data-disabled:opacity-50\"\n  maxX={20_000}\n  maxY={12}\n  minX={20}\n  minY={-12}\n  onValueChange={(point) => {\n    peak = point;\n  }}\n  scaleX=\"log\"\n>\n  <Plot.Grid\n    class=\"text-muted-foreground rounded-[inherit] text-[10px] text-muted-foreground tabular-nums leading-none [&>svg]:overflow-hidden! [&>svg]:rounded-[inherit] [&_[data-part=line]]:stroke-border [&_[data-part=line][data-zero]]:stroke-foreground/30 [&_[data-part=label]]:z-1 [&_[data-part=label]]:px-0.5 [&_[data-part=label]]:[text-shadow:0_0_2px_var(--card),0_0_2px_var(--card),0_0_4px_var(--card)] [&_[data-part=label][data-axis=x]]:-translate-x-1/2 [&_[data-part=label][data-axis=x]]:bottom-1.5 [&_[data-part=label][data-axis=y]]:-translate-y-1/2 [&_[data-part=label][data-axis=y]]:left-2\"\n    x={{ ticks: [100, 1000, 10_000] }}\n    y={{ ticks: [-12, 0, 12] }}\n  />\n  <div\n    class=\"text-primary absolute inset-0 overflow-hidden! rounded-[inherit]\"\n  >\n    <Plot.Curve class=\"fill-primary/15 stroke-none\" fillTo={0} fn={curve} />\n    <Plot.Curve\n      class=\"stroke-primary stroke-[1.5px] fill-none [stroke-linecap:round] [stroke-linejoin:round]\"\n      fn={curve}\n    />\n  </div>\n  <Plot.Handle\n    aria-label=\"Peak\"\n    class=\"rounded-full border-2 border-primary bg-background shadow-xs data-active:bg-primary transition-[box-shadow] duration-150 ease-out hover:ring-4 hover:ring-ring/30 focus-within:ring-4 focus-within:ring-ring/30 data-dragging:ring-4 data-dragging:ring-ring/30 motion-reduce:transition-none size-4 cursor-grab outline-none after:absolute after:-inset-2 pointer-coarse:after:-inset-3.5 data-dragging:cursor-grabbing data-disabled:pointer-events-none\"\n    handle=\"peak\"\n    value={peak}\n  />\n</Plot.Root>","path":"plot-demo.svelte","target":"components/examples/plot-demo.svelte","type":"registry:example"}],"name":"plot-svelte-demo","registryDependencies":["@audio-ui/plot-svelte"],"type":"registry:example"}