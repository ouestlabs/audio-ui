{"$schema":"https://ui.shadcn.com/schema/registry-item.json","description":"plot example, in the Vue adapter","files":[{"content":"<script lang=\"ts\" setup>\nimport { ref } from \"vue\";\nimport { Plot } from \"@/components/audio-ui/plot/vue\";\n\nconst peak = ref({ x: 1000, y: 6 });\nconst response = (hz: number, point: { x: number; y: number }) =>\n  point.y * Math.exp(-(Math.log2(hz / point.x) ** 2));\nconst curve = (hz: number) => response(hz, peak.value);\n</script>\n\n<template>\n  <Plot.Root\n    scale-x=\"log\"\n    :max-x=\"20_000\"\n    :max-y=\"12\"\n    :min-x=\"20\"\n    :min-y=\"-12\"\n    @value-change=\"(point) => { peak = point; }\"\n  >\n    <Plot.Grid\n      :x=\"{ ticks: [100, 1000, 10_000] }\"\n      :y=\"{ ticks: [-12, 0, 12] }\"\n    />\n    <div data-slot=\"plot-graph\">\n      <Plot.Curve :fill-to=\"0\" :fn=\"curve\" />\n      <Plot.Curve :fn=\"curve\" />\n    </div>\n    <Plot.Handle aria-label=\"Peak\" handle=\"peak\" :value=\"peak\" />\n  </Plot.Root>\n</template>","path":"plot-demo.vue","target":"components/examples/plot-demo.vue","type":"registry:example"}],"name":"plot-vue-demo","registryDependencies":["@audio-ui/plot-vue"],"type":"registry:example"}