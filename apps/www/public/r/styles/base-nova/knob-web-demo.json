{"$schema":"https://ui.shadcn.com/schema/registry-item.json","description":"Knob example, in the web adapter","files":[{"content":"import \"@/components/audio-ui/knob/web\";\n\n/** Draws the knob into `element`, and returns what takes it away. */\nexport function knobWebDemo(element: HTMLElement) {\n  element.innerHTML = `\n    <audio-ui-knob class=\"rounded-full border border-transparent ring-1 ring-foreground/10 transition-[border-color,box-shadow] duration-150 ease-out focus-within:border-ring focus-within:ring-3 focus-within:ring-ring/50 hover:ring-2 hover:ring-ring/40 has-[[data-slot=knob-control]:active]:border-ring has-[[data-slot=knob-control]:active]:ring-3 has-[[data-slot=knob-control]:active]:ring-ring motion-reduce:transition-none size-16 group/knob relative m-5 mb-12 inline-flex outline-none data-disabled:cursor-not-allowed\" value=\"50\" min=\"0\" max=\"100\" step=\"1\">\n      <audio-ui-knob-control class=\"bg-secondary text-secondary-foreground shadow-xs transition-[color,background-color,box-shadow,border-color,opacity] duration-150 ease-out hover:bg-secondary/90 active:shadow-[inset_0_-14px_28px_-12px_rgb(0_0_0/0.14)] motion-reduce:transition-none dark:bg-secondary/60 dark:hover:bg-secondary/70 dark:active:shadow-[inset_0_-14px_28px_-12px_rgb(0_0_0/0.28)] transform-[translateZ(0)] relative isolate flex size-full cursor-grab touch-none select-none outline-none [clip-path:circle(50%_at_50%_50%)] focus-visible:outline-none active:cursor-grabbing data-disabled:pointer-events-none data-disabled:opacity-50 data-[drag-mode=vertical]:cursor-ns-resize data-[drag-mode=vertical]:active:cursor-ns-resize\">\n        <div class=\"rounded-full bg-card text-card-foreground ring-1 ring-foreground/10 transition-transform duration-100 ease-out motion-reduce:transition-none inset-2 absolute z-0\"></div>\n        <audio-ui-knob-track class=\"text-primary [&_path]:stroke-current pointer-events-none absolute inset-0 z-1 block size-full opacity-22\"></audio-ui-knob-track>\n        <audio-ui-knob-indicator class=\"text-primary [&_path]:stroke-current pointer-events-none absolute inset-0 z-1 block size-full\"></audio-ui-knob-indicator>\n        <audio-ui-knob-thumb aria-label=\"Level\" class=\"pointer-events-none absolute inset-0 z-2\">\n          <svg aria-hidden=\"true\" class=\"text-primary block size-full\" viewBox=\"0 0 48 48\"><line stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"2.75\" x1=\"24\" x2=\"24\" y1=\"11.53\" y2=\"18.84\" /></svg>\n        </audio-ui-knob-thumb>\n      </audio-ui-knob-control>\n      <audio-ui-knob-mark value=\"0\">\n        <span class=\"bg-muted-foreground/40 transition-colors duration-150 ease-out in-data-[active]:data-[color]:bg-primary motion-reduce:transition-none -top-2.5 absolute left-1/2 h-1.5 w-px -translate-x-1/2\"></span>\n        <span class=\"text-[10px] leading-none text-muted-foreground tabular-nums in-data-[active]:text-foreground -top-6 absolute left-1/2 -translate-x-1/2 [rotate:calc(var(--knob-mark-angle)*-1)]\">0</span>\n      </audio-ui-knob-mark>\n      <audio-ui-knob-mark value=\"25\">\n        <span class=\"bg-muted-foreground/40 transition-colors duration-150 ease-out in-data-[active]:data-[color]:bg-primary motion-reduce:transition-none -top-2.5 absolute left-1/2 h-1.5 w-px -translate-x-1/2\"></span>\n      </audio-ui-knob-mark>\n      <audio-ui-knob-mark value=\"50\">\n        <span class=\"bg-muted-foreground/40 transition-colors duration-150 ease-out in-data-[active]:data-[color]:bg-primary motion-reduce:transition-none -top-2.5 absolute left-1/2 h-1.5 w-px -translate-x-1/2\"></span>\n      </audio-ui-knob-mark>\n      <audio-ui-knob-mark value=\"75\">\n        <span class=\"bg-muted-foreground/40 transition-colors duration-150 ease-out in-data-[active]:data-[color]:bg-primary motion-reduce:transition-none -top-2.5 absolute left-1/2 h-1.5 w-px -translate-x-1/2\"></span>\n      </audio-ui-knob-mark>\n      <audio-ui-knob-mark value=\"100\">\n        <span class=\"bg-muted-foreground/40 transition-colors duration-150 ease-out in-data-[active]:data-[color]:bg-primary motion-reduce:transition-none -top-2.5 absolute left-1/2 h-1.5 w-px -translate-x-1/2\"></span>\n        <span class=\"text-[10px] leading-none text-muted-foreground tabular-nums in-data-[active]:text-foreground -top-6 absolute left-1/2 -translate-x-1/2 [rotate:calc(var(--knob-mark-angle)*-1)]\">100</span>\n      </audio-ui-knob-mark>\n      <audio-ui-knob-value class=\"rounded-[min(var(--radius-sm),6px)] bg-foreground px-1.5 py-0.5 font-medium text-[10px] text-background tabular-nums leading-none shadow-sm absolute top-full left-1/2 z-10 mt-6 -translate-x-1/2 cursor-text whitespace-nowrap opacity-0 transition-opacity duration-150 ease-out group-hover/knob:opacity-100 group-has-focus-visible/knob:opacity-100 group-data-dragging/knob:opacity-100 data-editing:opacity-100 motion-reduce:transition-none\" editable></audio-ui-knob-value>\n    </audio-ui-knob>`;\n  return () => {\n    element.innerHTML = \"\";\n  };\n}","path":"knob-demo.ts","target":"components/examples/knob-demo.ts","type":"registry:example"}],"name":"knob-web-demo","registryDependencies":["@audio-ui/knob-web"],"type":"registry:example"}