{"$schema":"https://ui.shadcn.com/schema/registry-item.json","description":"sequencer example, in the Svelte adapter","files":[{"content":"<script lang=\"ts\">\nimport { onDestroy } from \"svelte\";\nimport {\n  triggerHihat,\n  triggerKick,\n  triggerSnare,\n} from \"@/lib/drum-synthesis\";\nimport { createStepPlayer } from \"@/lib/step-player\";\nimport { webAudio } from \"@/lib/web-audio\";\nimport { Sequencer } from \"$lib/components/audio-ui/sequencer/svelte\";\n\nconst STEPS = 16;\nconst BPM = 112;\nconst VOLUME = 0.7;\nconst ROWS = [\"Kick\", \"Snare\", \"Hihat\"];\nconst TRIGGERS = [triggerKick, triggerSnare, triggerHihat];\nconst VELOCITIES = [\n  [1, 0.5, 0.7, 0.5, 0.9, 0.5, 0.7, 0.5, 1, 0.5, 0.7, 0.5, 0.9, 0.5, 0.7, 0.6],\n  [1, 1, 1, 1, 0.8, 1, 1, 1, 1, 1, 1, 1, 0.85, 1, 1, 0.4],\n  [\n    0.55, 0.6, 0.9, 0.6, 0.55, 0.6, 0.9, 0.6, 0.55, 0.6, 0.9, 0.6, 0.55, 0.6,\n    0.9, 0.6,\n  ],\n];\nconst on = (steps: number[]) =>\n  Array.from({ length: STEPS }, (_, step) => steps.includes(step));\nconst BEAT = [on([0, 4, 8, 12]), on([4, 12]), on([2, 6, 10, 14])];\nconst EMPTY = () => ROWS.map(() => Array.from({ length: STEPS }, () => false));\n\n/** Plays what the pattern holds on a step: each hit goes through a gain of its own, the step's velocity. */\nfunction playStep(rows: boolean[][], levels: number[][], step: number) {\n  const ctx = webAudio.resume();\n  if (!ctx) {\n    return;\n  }\n  rows.forEach((row, at) => {\n    if (!row[step]) {\n      return;\n    }\n    const hit = ctx.createGain();\n    hit.gain.value = (levels[at]?.[step] ?? 1) * VOLUME;\n    hit.connect(ctx.destination);\n    TRIGGERS[at]?.(ctx, hit, ctx.currentTime);\n  });\n}\n\nlet pattern = $state(BEAT);\nlet velocities = $state(VELOCITIES);\nlet playing = $state(false);\nconst player = createStepPlayer({\n  bpm: BPM,\n  onStep: (step) => playStep(pattern, velocities, step),\n  steps: STEPS,\n});\n\nfunction toggle() {\n  if (player.isPlaying()) {\n    player.stop();\n  } else {\n    player.start();\n  }\n  playing = player.isPlaying();\n}\n\nfunction clear() {\n  pattern = EMPTY();\n}\n\nonDestroy(() => player.stop());\n</script>\n\n<div class=\"flex w-full flex-col gap-3\">\n  <Sequencer.Root\n    aria-label=\"Drum pattern\"\n    class=\"[--sequencer-off:var(--muted)] w-full min-w-0 select-none data-disabled:opacity-50 grid grid-cols-[auto_minmax(0,1fr)] gap-x-2 gap-y-1.5\"\n    onValueChange={(next) => {\n      pattern = next;\n    }}\n    onVelocityChange={(next) => {\n      velocities = next;\n    }}\n    source={player.source}\n    value={pattern}\n    {velocities}\n  >\n    {#snippet children(\n      state\n    )}\n      {#each Array.from({ length: state.rows }, (_, row) => row) as row (row)}\n        <Sequencer.Row\n          aria-label={ROWS[row]}\n          class=\"col-span-2 grid grid-cols-subgrid items-center\"\n          index={row}\n        >\n          <span\n            aria-hidden=\"true\"\n            class=\"max-w-24 truncate text-muted-foreground text-xs\"\n            >{ROWS[row]}</span\n          >\n          <div class=\"flex min-w-0 flex-1 flex-col gap-1\">\n            <div class=\"grid auto-cols-fr grid-flow-col gap-1\">\n              {#each Array.from(\n                { length: state.steps },\n                (_, step) => step\n              ) as step (step)}\n                <Sequencer.Cell\n                  aria-label={`${ROWS[row]}, step ${step + 1}`}\n                  class=\"rounded-[min(var(--radius-sm),6px)] border bg-muted/60 transition-[background-color,box-shadow,transform] duration-100 ease-out hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring/50 active:scale-95 aria-pressed:border-primary aria-pressed:bg-primary data-current:ring-2 data-current:ring-foreground/40 data-disabled:pointer-events-none motion-reduce:transition-none motion-reduce:active:scale-100 flex h-9 min-w-0 cursor-pointer touch-none items-center justify-center font-medium text-[9px] tabular-nums outline-none aria-pressed:text-primary-foreground {step %\n                    4 ===\n                  0\n                    ? \"bg-muted\"\n                    : \"\"}\"\n                  {row}\n                  {step}\n                />\n              {/each}\n            </div>\n            <div class=\"grid auto-cols-fr grid-flow-col gap-1\">\n              {#each Array.from(\n                { length: state.steps },\n                (_, step) => step\n              ) as step (step)}\n                <Sequencer.Velocity\n                  aria-label={`${ROWS[row]}, step ${step + 1} velocity`}\n                  class=\"overflow-hidden rounded-[min(var(--radius-sm),6px)] bg-muted/40 focus-within:ring-2 focus-within:ring-ring/50 data-disabled:pointer-events-none group/velocity relative h-8 min-w-0 cursor-ns-resize touch-none outline-none\"\n                  {row}\n                  {step}\n                >\n                  <span\n                    class=\"bg-primary/30 transition-[background-color] duration-100 ease-out motion-reduce:transition-none group-data-on/velocity:bg-primary absolute inset-x-0 bottom-0 h-[calc(var(--sequencer-velocity)*100%)]\"\n                  ></span>\n                </Sequencer.Velocity>\n              {/each}\n            </div>\n          </div>\n        </Sequencer.Row>\n      {/each}\n    {/snippet}\n  </Sequencer.Root>\n  <div class=\"flex items-center justify-between gap-2\">\n    <button\n      class=\"inline-flex h-8 items-center rounded-md border bg-background px-3 text-sm hover:bg-muted\"\n      onclick={toggle}\n      type=\"button\"\n    >\n      {playing ? \"Stop\" : \"Play\"}\n    </button>\n    <button\n      class=\"inline-flex h-8 items-center rounded-md px-3 text-sm hover:bg-muted\"\n      data-agent-confirm=\"Clears every step of the pattern\"\n      onclick={clear}\n      type=\"button\"\n    >\n      Clear\n    </button>\n  </div>\n</div>","path":"sequencer-demo.svelte","target":"components/examples/sequencer-demo.svelte","type":"registry:example"}],"name":"sequencer-svelte-demo","registryDependencies":["@audio-ui/sequencer-svelte","@audio-ui/web-audio","@audio-ui/drum-synthesis","@audio-ui/step-player"],"type":"registry:example"}