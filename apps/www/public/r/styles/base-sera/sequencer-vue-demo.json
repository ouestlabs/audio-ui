{"$schema":"https://ui.shadcn.com/schema/registry-item.json","description":"sequencer example, in the Vue adapter","files":[{"content":"<script lang=\"ts\" setup>\nimport { onBeforeUnmount, ref } from \"vue\";\nimport Sequencer from \"@/components/audio-ui/sequencer/Sequencer.vue\";\nimport {\n  triggerHihat,\n  triggerKick,\n  triggerSnare,\n} from \"@/lib/drum-synthesis\";\nimport { createStepPlayer } from \"@/lib/step-player\";\nimport { webAudio } from \"@/lib/web-audio\";\n\nconst STEPS = 16;\nconst BPM = 112;\nconst VOLUME = 0.7;\nconst ROWS = [\"Kick\", \"Snare\", \"Hihat\"];\nconst TRIGGERS = [triggerKick, triggerSnare, triggerHihat];\nconst VELOCITIES = [\n  [1, 0.5, 0.7, 0.5, 0.9, 0.5, 0.7, 0.5, 1, 0.5, 0.7, 0.5, 0.9, 0.5, 0.7, 0.6],\n  [1, 1, 1, 1, 0.8, 1, 1, 1, 1, 1, 1, 1, 0.85, 1, 1, 0.4],\n  [\n    0.55, 0.6, 0.9, 0.6, 0.55, 0.6, 0.9, 0.6, 0.55, 0.6, 0.9, 0.6, 0.55, 0.6,\n    0.9, 0.6,\n  ],\n];\nconst on = (steps: number[]) =>\n  Array.from({ length: STEPS }, (_, step) => steps.includes(step));\nconst BEAT = [on([0, 4, 8, 12]), on([4, 12]), on([2, 6, 10, 14])];\nconst EMPTY = () => ROWS.map(() => Array.from({ length: STEPS }, () => false));\n\n/** Plays what the pattern holds on a step: each hit goes through a gain of its own, the step's velocity. */\nfunction playStep(rows: boolean[][], levels: number[][], step: number) {\n  const ctx = webAudio.resume();\n  if (!ctx) {\n    return;\n  }\n  rows.forEach((row, at) => {\n    if (!row[step]) {\n      return;\n    }\n    const hit = ctx.createGain();\n    hit.gain.value = (levels[at]?.[step] ?? 1) * VOLUME;\n    hit.connect(ctx.destination);\n    TRIGGERS[at]?.(ctx, hit, ctx.currentTime);\n  });\n}\n\nconst pattern = ref(BEAT);\nconst velocities = ref(VELOCITIES);\nconst playing = ref(false);\nconst player = createStepPlayer({\n  bpm: BPM,\n  onStep: (step) => playStep(pattern.value, velocities.value, step),\n  steps: STEPS,\n});\n\nfunction toggle() {\n  if (player.isPlaying()) {\n    player.stop();\n  } else {\n    player.start();\n  }\n  playing.value = player.isPlaying();\n}\n\nonBeforeUnmount(() => player.stop());\n</script>\n\n<template>\n  <div style=\"display: flex; flex-direction: column; gap: 0.75rem; width: 100%\">\n    <Sequencer\n      aria-label=\"Drum pattern\"\n      show-velocity\n      :row-labels=\"ROWS\"\n      :source=\"player.source\"\n      :value=\"pattern\"\n      :velocities=\"velocities\"\n      @value-change=\"(next) => { pattern = next; }\"\n      @velocity-change=\"(next) => { velocities = next; }\"\n    />\n    <div\n      style=\"display: flex; align-items: center; justify-content: space-between; gap: 0.5rem\"\n    >\n      <button\n        style=\"height: 2rem; padding: 0 0.75rem; border: 1px solid var(--border); border-radius: var(--radius, 0.5rem); background: var(--background); color: var(--foreground); font: inherit; font-size: 0.875rem; cursor: pointer\"\n        type=\"button\"\n        @click=\"toggle\"\n      >\n        {{ playing ? \"Stop\" : \"Play\" }}\n      </button>\n      <button\n        data-agent-confirm=\"Clears every step of the pattern\"\n        style=\"height: 2rem; padding: 0 0.75rem; border: 0; border-radius: var(--radius, 0.5rem); background: transparent; color: var(--foreground); font: inherit; font-size: 0.875rem; cursor: pointer\"\n        type=\"button\"\n        @click=\"pattern = EMPTY()\"\n      >\n        Clear\n      </button>\n    </div>\n  </div>\n</template>","path":"sequencer-demo.vue","target":"components/examples/sequencer-demo.vue","type":"registry:example"}],"name":"sequencer-vue-demo","registryDependencies":["@audio-ui/sequencer-element-vue","@audio-ui/web-audio","@audio-ui/drum-synthesis","@audio-ui/step-player"],"type":"registry:example"}