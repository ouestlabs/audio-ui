{"$schema":"https://ui.shadcn.com/schema/registry-item.json","description":"meter example, in the Svelte adapter","files":[{"content":"<script lang=\"ts\">\nimport { createSimulatedLevels } from \"@/lib/simulated-levels\";\nimport { Meter } from \"$lib/components/audio-ui/meter/svelte\";\n\nconst simulated = createSimulatedLevels(2);\n$effect(() => simulated.run());\n\nconst decibels = (formattedValue: string) => `${formattedValue} dB`;\n</script>\n\n<Meter.Root\n  aria-label=\"Stereo output\"\n  class=\"relative data-[orientation=vertical]:h-48 data-[orientation=vertical]:[--meter-thickness:--spacing(3.5)] data-[orientation=horizontal]:[--meter-thickness:--spacing(3)] flex select-none gap-1 data-[orientation=horizontal]:mb-6 data-[orientation=horizontal]:w-full data-[orientation=horizontal]:flex-col data-[orientation=vertical]:me-8 data-[orientation=vertical]:w-fit\"\n  source={simulated.source}\n  warnThreshold={-12}\n>\n  {#snippet children(\n    state\n  )}\n    {#each Array.from(\n      { length: state.channelCount },\n      (_, index) => index\n    ) as index (index)}\n      <Meter.Channel\n        aria-label={`Stereo output ${index + 1}`}\n        class=\"rounded-none bg-[color:var(--audio-groove,color-mix(in_oklab,var(--input)_70%,transparent))] transition-shadow duration-150 ease-out data-clipping:ring-2 data-clipped:ring-2 data-clipping:ring-destructive data-clipped:ring-destructive relative flex-1 overflow-hidden data-[orientation=horizontal]:h-(--meter-thickness,auto) data-[orientation=horizontal]:flex-none data-[orientation=vertical]:w-(--meter-thickness,auto) data-[orientation=vertical]:flex-none\"\n        getAriaValueText={decibels}\n        {index}\n      >\n        <Meter.Indicator class=\"bg-[color:var(--audio-level,var(--success))] data-warning:bg-[color:var(--audio-warn,var(--warning))] data-clipping:bg-[color:var(--audio-clip,var(--destructive))] data-clipped:bg-[color:var(--audio-clip,var(--destructive))] absolute inset-0\" />\n        <Meter.Peak\n          class=\"bg-[color:var(--audio-readout,var(--foreground))] absolute data-[orientation=horizontal]:top-0 data-[orientation=horizontal]:bottom-0 data-[orientation=horizontal]:w-0.5 data-[orientation=vertical]:right-0 data-[orientation=vertical]:left-0 data-[orientation=vertical]:h-0.5\"\n        />\n      </Meter.Channel>\n    {/each}\n    <Meter.Mark\n      class=\"text-[color:var(--audio-print,var(--muted-foreground))] flex items-center gap-1 text-[10px] tabular-nums data-[orientation=vertical]:left-full data-[orientation=vertical]:ms-1 data-[orientation=horizontal]:top-full data-[orientation=horizontal]:mt-1 data-[orientation=horizontal]:-translate-x-1/2 data-[orientation=vertical]:translate-y-1/2 data-[orientation=horizontal]:flex-col\"\n      value={6}\n    >\n      <span\n        aria-hidden=\"true\"\n        class=\"bg-current opacity-40 data-[orientation=horizontal]:h-1 data-[orientation=horizontal]:w-px data-[orientation=vertical]:h-px data-[orientation=vertical]:w-1.5\"\n        data-orientation=\"vertical\"\n      ></span>\n      <span class=\"min-w-4 text-end data-[orientation=horizontal]:text-center\"\n        >6</span\n      >\n    </Meter.Mark>\n    <Meter.Mark\n      class=\"text-[color:var(--audio-print,var(--muted-foreground))] flex items-center gap-1 text-[10px] tabular-nums data-[orientation=vertical]:left-full data-[orientation=vertical]:ms-1 data-[orientation=horizontal]:top-full data-[orientation=horizontal]:mt-1 data-[orientation=horizontal]:-translate-x-1/2 data-[orientation=vertical]:translate-y-1/2 data-[orientation=horizontal]:flex-col\"\n      value={0}\n    >\n      <span\n        aria-hidden=\"true\"\n        class=\"bg-current opacity-40 data-[orientation=horizontal]:h-1 data-[orientation=horizontal]:w-px data-[orientation=vertical]:h-px data-[orientation=vertical]:w-1.5\"\n        data-orientation=\"vertical\"\n      ></span>\n      <span class=\"min-w-4 text-end data-[orientation=horizontal]:text-center\"\n        >0</span\n      >\n    </Meter.Mark>\n    <Meter.Mark\n      class=\"text-[color:var(--audio-print,var(--muted-foreground))] flex items-center gap-1 text-[10px] tabular-nums data-[orientation=vertical]:left-full data-[orientation=vertical]:ms-1 data-[orientation=horizontal]:top-full data-[orientation=horizontal]:mt-1 data-[orientation=horizontal]:-translate-x-1/2 data-[orientation=vertical]:translate-y-1/2 data-[orientation=horizontal]:flex-col\"\n      value={-6}\n    >\n      <span\n        aria-hidden=\"true\"\n        class=\"bg-current opacity-40 data-[orientation=horizontal]:h-1 data-[orientation=horizontal]:w-px data-[orientation=vertical]:h-px data-[orientation=vertical]:w-1.5\"\n        data-orientation=\"vertical\"\n      ></span>\n      <span class=\"min-w-4 text-end data-[orientation=horizontal]:text-center\"\n        >-6</span\n      >\n    </Meter.Mark>\n    <Meter.Mark\n      class=\"text-[color:var(--audio-print,var(--muted-foreground))] flex items-center gap-1 text-[10px] tabular-nums data-[orientation=vertical]:left-full data-[orientation=vertical]:ms-1 data-[orientation=horizontal]:top-full data-[orientation=horizontal]:mt-1 data-[orientation=horizontal]:-translate-x-1/2 data-[orientation=vertical]:translate-y-1/2 data-[orientation=horizontal]:flex-col\"\n      value={-12}\n    >\n      <span\n        aria-hidden=\"true\"\n        class=\"bg-current opacity-40 data-[orientation=horizontal]:h-1 data-[orientation=horizontal]:w-px data-[orientation=vertical]:h-px data-[orientation=vertical]:w-1.5\"\n        data-orientation=\"vertical\"\n      ></span>\n      <span class=\"min-w-4 text-end data-[orientation=horizontal]:text-center\"\n        >-12</span\n      >\n    </Meter.Mark>\n    <Meter.Mark\n      class=\"text-[color:var(--audio-print,var(--muted-foreground))] flex items-center gap-1 text-[10px] tabular-nums data-[orientation=vertical]:left-full data-[orientation=vertical]:ms-1 data-[orientation=horizontal]:top-full data-[orientation=horizontal]:mt-1 data-[orientation=horizontal]:-translate-x-1/2 data-[orientation=vertical]:translate-y-1/2 data-[orientation=horizontal]:flex-col\"\n      value={-20}\n    >\n      <span\n        aria-hidden=\"true\"\n        class=\"bg-current opacity-40 data-[orientation=horizontal]:h-1 data-[orientation=horizontal]:w-px data-[orientation=vertical]:h-px data-[orientation=vertical]:w-1.5\"\n        data-orientation=\"vertical\"\n      ></span>\n      <span class=\"min-w-4 text-end data-[orientation=horizontal]:text-center\"\n        >-20</span\n      >\n    </Meter.Mark>\n    <Meter.Mark\n      class=\"text-[color:var(--audio-print,var(--muted-foreground))] flex items-center gap-1 text-[10px] tabular-nums data-[orientation=vertical]:left-full data-[orientation=vertical]:ms-1 data-[orientation=horizontal]:top-full data-[orientation=horizontal]:mt-1 data-[orientation=horizontal]:-translate-x-1/2 data-[orientation=vertical]:translate-y-1/2 data-[orientation=horizontal]:flex-col\"\n      value={-30}\n    >\n      <span\n        aria-hidden=\"true\"\n        class=\"bg-current opacity-40 data-[orientation=horizontal]:h-1 data-[orientation=horizontal]:w-px data-[orientation=vertical]:h-px data-[orientation=vertical]:w-1.5\"\n        data-orientation=\"vertical\"\n      ></span>\n      <span class=\"min-w-4 text-end data-[orientation=horizontal]:text-center\"\n        >-30</span\n      >\n    </Meter.Mark>\n    <Meter.Mark\n      class=\"text-[color:var(--audio-print,var(--muted-foreground))] flex items-center gap-1 text-[10px] tabular-nums data-[orientation=vertical]:left-full data-[orientation=vertical]:ms-1 data-[orientation=horizontal]:top-full data-[orientation=horizontal]:mt-1 data-[orientation=horizontal]:-translate-x-1/2 data-[orientation=vertical]:translate-y-1/2 data-[orientation=horizontal]:flex-col\"\n      value={-40}\n    >\n      <span\n        aria-hidden=\"true\"\n        class=\"bg-current opacity-40 data-[orientation=horizontal]:h-1 data-[orientation=horizontal]:w-px data-[orientation=vertical]:h-px data-[orientation=vertical]:w-1.5\"\n        data-orientation=\"vertical\"\n      ></span>\n      <span class=\"min-w-4 text-end data-[orientation=horizontal]:text-center\"\n        >-40</span\n      >\n    </Meter.Mark>\n    <Meter.Mark\n      class=\"text-[color:var(--audio-print,var(--muted-foreground))] flex items-center gap-1 text-[10px] tabular-nums data-[orientation=vertical]:left-full data-[orientation=vertical]:ms-1 data-[orientation=horizontal]:top-full data-[orientation=horizontal]:mt-1 data-[orientation=horizontal]:-translate-x-1/2 data-[orientation=vertical]:translate-y-1/2 data-[orientation=horizontal]:flex-col\"\n      value={-60}\n    >\n      <span\n        aria-hidden=\"true\"\n        class=\"bg-current opacity-40 data-[orientation=horizontal]:h-1 data-[orientation=horizontal]:w-px data-[orientation=vertical]:h-px data-[orientation=vertical]:w-1.5\"\n        data-orientation=\"vertical\"\n      ></span>\n      <span class=\"min-w-4 text-end data-[orientation=horizontal]:text-center\"\n        >-60</span\n      >\n    </Meter.Mark>\n  {/snippet}\n</Meter.Root>","path":"meter-demo.svelte","target":"components/examples/meter-demo.svelte","type":"registry:example"}],"name":"meter-svelte-demo","registryDependencies":["@audio-ui/meter-svelte","@audio-ui/simulated-levels"],"type":"registry:example"}