{"$schema":"https://ui.shadcn.com/schema/registry-item.json","description":"fader example, in the web adapter","files":[{"content":"import \"@/components/audio-ui/fader/web\";\n\n/** Draws the demo into `element`, and returns what takes it away. */\nexport function faderWebDemo(element) {\n  element.innerHTML = `\n    <audio-ui-fader class=\"group/fader relative data-[orientation=vertical]:h-full data-[orientation=horizontal]:w-full data-disabled:cursor-not-allowed data-[orientation=horizontal]:pb-6 data-[orientation=vertical]:ps-10\" default-value=\"50\" max=\"100\" min=\"0\" orientation=\"vertical\" step=\"1\">\n      <audio-ui-fader-control class=\"relative flex w-full touch-none select-none items-center data-[orientation=vertical]:h-full data-[orientation=vertical]:min-h-[var(--fader-min-height,10rem)] data-[orientation=vertical]:w-auto data-[orientation=vertical]:flex-col data-[orientation=horizontal]:w-full data-[orientation=horizontal]:min-w-32 transition-opacity duration-150 ease-out motion-reduce:transition-none data-disabled:pointer-events-none data-disabled:opacity-50\">\n        <audio-ui-fader-track class=\"rounded-none bg-[color:var(--audio-groove,color-mix(in_oklab,var(--input)_90%,transparent))] data-[orientation=horizontal]:h-2 data-[orientation=vertical]:h-full data-[orientation=horizontal]:w-full data-[orientation=vertical]:w-2 relative grow cursor-pointer select-none overflow-hidden\">\n          <audio-ui-fader-indicator class=\"bg-[color:var(--audio-accent,var(--primary))] absolute select-none data-[orientation=horizontal]:h-full data-[orientation=vertical]:w-full data-[orientation=vertical]:bottom-0\"></audio-ui-fader-indicator>\n        </audio-ui-fader-track>\n        <div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-y-0 end-[calc(50%+0.75rem)]\">\n          <audio-ui-fader-mark class=\"flex items-center gap-1 end-0 translate-y-1/2 flex-row\" value=\"0\">\n            <span class=\"text-[10px] leading-none text-[color:var(--audio-print,var(--muted-foreground))] tabular-nums in-data-[active]:text-[color:var(--audio-readout,var(--foreground))]\">0</span>\n            <span class=\"bg-[color:var(--audio-print,color-mix(in_oklab,var(--muted-foreground)_40%,transparent))] transition-colors duration-150 ease-out in-data-[active]:data-[color]:bg-[color:var(--audio-accent,var(--primary))] motion-reduce:transition-none h-px w-1.5\"></span>\n          </audio-ui-fader-mark>\n          <audio-ui-fader-mark class=\"flex items-center gap-1 end-0 translate-y-1/2 flex-row\" value=\"25\">\n            <span class=\"bg-[color:var(--audio-print,color-mix(in_oklab,var(--muted-foreground)_40%,transparent))] transition-colors duration-150 ease-out in-data-[active]:data-[color]:bg-[color:var(--audio-accent,var(--primary))] motion-reduce:transition-none h-px w-1.5\"></span>\n          </audio-ui-fader-mark>\n          <audio-ui-fader-mark class=\"flex items-center gap-1 end-0 translate-y-1/2 flex-row\" value=\"50\">\n            <span class=\"bg-[color:var(--audio-print,color-mix(in_oklab,var(--muted-foreground)_40%,transparent))] transition-colors duration-150 ease-out in-data-[active]:data-[color]:bg-[color:var(--audio-accent,var(--primary))] motion-reduce:transition-none h-px w-1.5\"></span>\n          </audio-ui-fader-mark>\n          <audio-ui-fader-mark class=\"flex items-center gap-1 end-0 translate-y-1/2 flex-row\" value=\"75\">\n            <span class=\"bg-[color:var(--audio-print,color-mix(in_oklab,var(--muted-foreground)_40%,transparent))] transition-colors duration-150 ease-out in-data-[active]:data-[color]:bg-[color:var(--audio-accent,var(--primary))] motion-reduce:transition-none h-px w-1.5\"></span>\n          </audio-ui-fader-mark>\n          <audio-ui-fader-mark class=\"flex items-center gap-1 end-0 translate-y-1/2 flex-row\" value=\"100\">\n            <span class=\"text-[10px] leading-none text-[color:var(--audio-print,var(--muted-foreground))] tabular-nums in-data-[active]:text-[color:var(--audio-readout,var(--foreground))]\">100</span>\n            <span class=\"bg-[color:var(--audio-print,color-mix(in_oklab,var(--muted-foreground)_40%,transparent))] transition-colors duration-150 ease-out in-data-[active]:data-[color]:bg-[color:var(--audio-accent,var(--primary))] motion-reduce:transition-none h-px w-1.5\"></span>\n          </audio-ui-fader-mark>\n        </div>\n        <audio-ui-fader-thumb aria-label=\"Volume\" class=\"rounded-none border-ring border bg-[color:var(--audio-cap,var(--card))] transition-[color,box-shadow] hover:ring-1 hover:ring-ring/40 has-focus-visible:ring-1 has-focus-visible:ring-ring/50 active:ring-1 active:ring-ring/50 motion-reduce:transition-none data-[orientation=horizontal]:h-4 data-[orientation=vertical]:h-6 data-[orientation=horizontal]:w-6 data-[orientation=vertical]:w-4 before:-inset-2 absolute z-10 block shrink-0 cursor-grab select-none outline-none before:absolute before:content-[''] active:cursor-grabbing data-disabled:pointer-events-none\">\n          <div class=\"data-[orientation=horizontal]:px-1.5 data-[orientation=horizontal]:py-1 data-[orientation=vertical]:px-1 data-[orientation=vertical]:py-1.5 flex h-full w-full items-center justify-center gap-0.5 data-[orientation=horizontal]:flex-row data-[orientation=vertical]:flex-col\" data-orientation=\"vertical\">\n            <div class=\"bg-[color:var(--audio-accent,var(--primary))] opacity-50 data-[orientation=horizontal]:h-2.5 data-[orientation=vertical]:h-px data-[orientation=horizontal]:w-px data-[orientation=vertical]:w-2.5\" data-orientation=\"vertical\"></div>\n            <div class=\"bg-[color:var(--audio-accent,var(--primary))] opacity-50 data-[orientation=horizontal]:h-2.5 data-[orientation=vertical]:h-px data-[orientation=horizontal]:w-px data-[orientation=vertical]:w-2.5\" data-orientation=\"vertical\"></div>\n            <div class=\"bg-[color:var(--audio-accent,var(--primary))] opacity-50 data-[orientation=horizontal]:h-2.5 data-[orientation=vertical]:h-px data-[orientation=horizontal]:w-px data-[orientation=vertical]:w-2.5\" data-orientation=\"vertical\"></div>\n          </div>\n          <audio-ui-fader-value class=\"rounded-none bg-[color:var(--audio-readout,var(--foreground))] px-1.5 py-0.5 font-medium text-[10px] text-[color:var(--audio-readout-ink,var(--background))] tabular-nums leading-none shadow-sm absolute z-20 whitespace-nowrap cursor-text start-full top-1/2 ms-2 -translate-y-1/2 opacity-0 transition-opacity duration-150 ease-out group-hover/fader:opacity-100 group-has-focus-visible/fader:opacity-100 group-has-data-dragging/fader:opacity-100 data-editing:opacity-100 motion-reduce:transition-none\" editable></audio-ui-fader-value>\n        </audio-ui-fader-thumb>\n      </audio-ui-fader-control>\n    </audio-ui-fader>`;\n  return () => {\n    element.innerHTML = \"\";\n  };\n}","path":"fader-demo.js","target":"components/examples/fader-demo.js","type":"registry:example"}],"name":"fader-web-demo","registryDependencies":["@audio-ui/fader-web"],"type":"registry:example"}