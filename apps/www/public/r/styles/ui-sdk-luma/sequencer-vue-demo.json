{"$schema":"https://ui.shadcn.com/schema/registry-item.json","description":"sequencer example, in the Vue adapter","files":[{"content":"<script lang=\"ts\" setup>\nimport { onBeforeUnmount, ref } from \"vue\";\nimport {\n  triggerHihat,\n  triggerKick,\n  triggerSnare,\n} from \"@/lib/drum-synthesis\";\nimport { createStepPlayer } from \"@/lib/step-player\";\nimport { webAudio } from \"@/lib/web-audio\";\nimport { Sequencer } from \"@/components/audio-ui/sequencer/vue\";\n\nconst STEPS = 16;\nconst BPM = 112;\nconst VOLUME = 0.7;\nconst ROWS = [\"Kick\", \"Snare\", \"Hihat\"];\nconst TRIGGERS = [triggerKick, triggerSnare, triggerHihat];\nconst VELOCITIES = [\n  [1, 0.5, 0.7, 0.5, 0.9, 0.5, 0.7, 0.5, 1, 0.5, 0.7, 0.5, 0.9, 0.5, 0.7, 0.6],\n  [1, 1, 1, 1, 0.8, 1, 1, 1, 1, 1, 1, 1, 0.85, 1, 1, 0.4],\n  [\n    0.55, 0.6, 0.9, 0.6, 0.55, 0.6, 0.9, 0.6, 0.55, 0.6, 0.9, 0.6, 0.55, 0.6,\n    0.9, 0.6,\n  ],\n];\nconst on = (steps: number[]) =>\n  Array.from({ length: STEPS }, (_, step) => steps.includes(step));\nconst BEAT = [on([0, 4, 8, 12]), on([4, 12]), on([2, 6, 10, 14])];\nconst EMPTY = () => ROWS.map(() => Array.from({ length: STEPS }, () => false));\n\n/** Plays what the pattern holds on a step: each hit goes through a gain of its own, the step's velocity. */\nfunction playStep(rows: boolean[][], levels: number[][], step: number) {\n  const ctx = webAudio.resume();\n  if (!ctx) {\n    return;\n  }\n  rows.forEach((row, at) => {\n    if (!row[step]) {\n      return;\n    }\n    const hit = ctx.createGain();\n    hit.gain.value = (levels[at]?.[step] ?? 1) * VOLUME;\n    hit.connect(ctx.destination);\n    TRIGGERS[at]?.(ctx, hit, ctx.currentTime);\n  });\n}\n\nconst pattern = ref(BEAT);\nconst velocities = ref(VELOCITIES);\nconst playing = ref(false);\nconst player = createStepPlayer({\n  bpm: BPM,\n  onStep: (step) => playStep(pattern.value, velocities.value, step),\n  steps: STEPS,\n});\n\nfunction toggle() {\n  if (player.isPlaying()) {\n    player.stop();\n  } else {\n    player.start();\n  }\n  playing.value = player.isPlaying();\n}\n\nonBeforeUnmount(() => player.stop());\n</script>\n\n<template>\n  <div class=\"flex w-full flex-col gap-3\">\n    <Sequencer.Root\n      aria-label=\"Drum pattern\"\n      class=\"[--sequencer-off:var(--muted)] w-full min-w-0 select-none data-disabled:opacity-50 grid grid-cols-[auto_minmax(0,1fr)] gap-x-2 gap-y-1.5\"\n      :source=\"player.source\"\n      :value=\"pattern\"\n      :velocities=\"velocities\"\n      @value-change=\"(next) => { pattern = next; }\"\n      @velocity-change=\"(next) => { velocities = next; }\"\n    >\n      <template #default=\"{ state }\">\n        <Sequencer.Row\n          class=\"col-span-2 grid grid-cols-subgrid items-center\"\n          v-for=\"row in state.rows\"\n          :key=\"row\"\n          :aria-label=\"ROWS[row - 1]\"\n          :index=\"row - 1\"\n        >\n          <span\n            aria-hidden=\"true\"\n            class=\"max-w-24 truncate text-muted-foreground text-xs\"\n            >{{\n              ROWS[row - 1]\n            }}</span\n          >\n          <div class=\"flex min-w-0 flex-1 flex-col gap-1\">\n            <div class=\"grid auto-cols-fr grid-flow-col gap-1\">\n              <Sequencer.Cell\n                class=\"rounded-[min(var(--radius-sm),6px)] border bg-muted/60 transition-[background-color,box-shadow,transform] duration-100 ease-out hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring/50 active:scale-95 aria-pressed:border-primary aria-pressed:bg-primary data-current:ring-2 data-current:ring-foreground/40 data-disabled:pointer-events-none motion-reduce:transition-none motion-reduce:active:scale-100 flex h-9 min-w-0 cursor-pointer touch-none items-center justify-center font-medium text-[9px] tabular-nums outline-none aria-pressed:text-primary-foreground\"\n                v-for=\"step in state.steps\"\n                :key=\"step\"\n                :aria-label=\"`${ROWS[row - 1]}, step ${step}`\"\n                :class=\"(step - 1) % 4 === 0 && 'bg-muted'\"\n                :row=\"row - 1\"\n                :step=\"step - 1\"\n              />\n            </div>\n            <div class=\"grid auto-cols-fr grid-flow-col gap-1\">\n              <Sequencer.Velocity\n                class=\"overflow-hidden rounded-[min(var(--radius-sm),6px)] bg-muted/40 focus-within:ring-2 focus-within:ring-ring/50 data-disabled:pointer-events-none group/velocity relative h-8 min-w-0 cursor-ns-resize touch-none outline-none\"\n                v-for=\"step in state.steps\"\n                :key=\"step\"\n                :aria-label=\"`${ROWS[row - 1]}, step ${step} velocity`\"\n                :row=\"row - 1\"\n                :step=\"step - 1\"\n              >\n                <span\n                  class=\"bg-primary/30 transition-[background-color] duration-100 ease-out motion-reduce:transition-none group-data-on/velocity:bg-primary absolute inset-x-0 bottom-0 h-[calc(var(--sequencer-velocity)*100%)]\"\n                />\n              </Sequencer.Velocity>\n            </div>\n          </div>\n        </Sequencer.Row>\n      </template>\n    </Sequencer.Root>\n    <div class=\"flex items-center justify-between gap-2\">\n      <button\n        class=\"inline-flex h-8 items-center rounded-md border bg-background px-3 text-sm hover:bg-muted\"\n        type=\"button\"\n        @click=\"toggle\"\n      >\n        {{ playing ? \"Stop\" : \"Play\" }}\n      </button>\n      <button\n        class=\"inline-flex h-8 items-center rounded-md px-3 text-sm hover:bg-muted\"\n        data-agent-confirm=\"Clears every step of the pattern\"\n        type=\"button\"\n        @click=\"pattern = EMPTY()\"\n      >\n        Clear\n      </button>\n    </div>\n  </div>\n</template>","path":"sequencer-demo.vue","target":"components/examples/sequencer-demo.vue","type":"registry:example"}],"name":"sequencer-vue-demo","registryDependencies":["@audio-ui/sequencer-vue","@audio-ui/web-audio","@audio-ui/drum-synthesis","@audio-ui/step-player"],"type":"registry:example"}