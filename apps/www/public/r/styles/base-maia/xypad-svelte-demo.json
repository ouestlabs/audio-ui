{"$schema":"https://ui.shadcn.com/schema/registry-item.json","description":"xypad example, in the Svelte adapter","files":[{"content":"<script lang=\"ts\">\nimport { XYPad } from \"$lib/components/audio-ui/xypad/svelte\";\n\nlet value = $state({ x: 50, y: 50 });\n</script>\n\n<div class=\"flex flex-col items-center gap-2\">\n  <XYPad.Root\n    class=\"data-disabled:cursor-not-allowed\"\n    maxX={100}\n    maxY={100}\n    minX={0}\n    minY={0}\n    onValueChange={(next) => {\n      value = next;\n    }}\n    {value}\n  >\n    <XYPad.Control\n      class=\"rounded-2xl border border-transparent bg-card ring-1 ring-foreground/10 transition-[color,border-color,box-shadow,opacity] duration-150 ease-out hover:ring-4 hover:ring-ring/50 has-focus-visible:ring-4 has-focus-visible:ring-ring/50 active:ring-4 active:ring-ring/50 has-focus-visible:border-ring active:border-ring motion-reduce:transition-none h-48 relative block aspect-square w-full cursor-crosshair touch-none select-none overflow-hidden data-disabled:pointer-events-none data-disabled:opacity-50\"\n    >\n      <div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0\">\n        <div\n          class=\"bg-border opacity-30 absolute top-0 bottom-0 w-px\"\n          style=\"left: 20%\"\n        />\n        <div\n          class=\"bg-border opacity-30 absolute top-0 bottom-0 w-px\"\n          style=\"left: 40%\"\n        />\n        <div\n          class=\"bg-border opacity-30 absolute top-0 bottom-0 w-px\"\n          style=\"left: 60%\"\n        />\n        <div\n          class=\"bg-border opacity-30 absolute top-0 bottom-0 w-px\"\n          style=\"left: 80%\"\n        />\n        <div\n          class=\"bg-border opacity-30 absolute right-0 left-0 h-px\"\n          style=\"top: 20%\"\n        />\n        <div\n          class=\"bg-border opacity-30 absolute right-0 left-0 h-px\"\n          style=\"top: 40%\"\n        />\n        <div\n          class=\"bg-border opacity-30 absolute right-0 left-0 h-px\"\n          style=\"top: 60%\"\n        />\n        <div\n          class=\"bg-border opacity-30 absolute right-0 left-0 h-px\"\n          style=\"top: 80%\"\n        />\n      </div>\n      <div\n        aria-hidden=\"true\"\n        class=\"bg-primary opacity-50 pointer-events-none absolute top-0 bottom-0 left-(--xy-pad-x) w-px\"\n      />\n      <div\n        aria-hidden=\"true\"\n        class=\"bg-primary opacity-50 pointer-events-none absolute top-(--xy-pad-y) right-0 left-0 h-px\"\n      />\n      <XYPad.Thumb\n        aria-label=\"Position\"\n        class=\"pointer-events-none absolute size-5\"\n      >\n        <div\n          class=\"rounded-4xl bg-primary opacity-20 blur-sm absolute inset-0 transition-opacity duration-200 motion-reduce:transition-none\"\n        />\n        <div class=\"rounded-[min(var(--radius-md),4px)] bg-primary shadow-sm absolute inset-1\" />\n        <div class=\"rounded-4xl bg-primary-foreground opacity-30 absolute inset-2\" />\n      </XYPad.Thumb>\n      <XYPad.Value class=\"rounded-4xl bg-background/90 px-2 py-1 font-mono text-muted-foreground text-xs ring-1 ring-foreground/10 backdrop-blur-md absolute top-2.5 right-2.5 z-10\" />\n    </XYPad.Control>\n  </XYPad.Root>\n  <output\n    aria-live=\"polite\"\n    class=\"font-mono text-foreground text-sm tabular-nums\"\n  >\n    X: {value.x} - Y: {value.y}\n  </output>\n</div>","path":"xypad-demo.svelte","target":"components/examples/xypad-demo.svelte","type":"registry:example"}],"name":"xypad-svelte-demo","registryDependencies":["@audio-ui/xypad-svelte"],"type":"registry:example"}