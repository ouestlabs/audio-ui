{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "audio-ui",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // A Preview inherits no binding: it gets the API's rate limit here, counted
  // apart from production's (its own namespace_id).
  "previews": {
    "ratelimits": [
      {
        "name": "API_RATE_LIMIT",
        "namespace_id": "61802",
        "simple": { "limit": 120, "period": 60 }
      }
    ]
  },
  "main": "@tanstack/react-start/server-entry",
  "assets": {
    "binding": "ASSETS",
    // The home runs the Worker first: it answers in HTML or in markdown, by the request's Accept.
    "run_worker_first": ["/", "/r/*", "/ingest/*"],
    "html_handling": "drop-trailing-slash"
  },
  // The REST API's quota per client address, per Cloudflare location
  // (approximate): what its RateLimit-Policy header announces.
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      // Unique in the Cloudflare account: no other Worker counts against it.
      "namespace_id": "61801",
      "simple": { "limit": 120, "period": 60 }
    }
  ]
}
