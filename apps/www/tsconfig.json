{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/components/audio-ui/parameter-field": [
        "./src/registry/bases/ui-sdk/audio-ui/elements/parameter-field.tsx"
      ],
      "@/components/audio-ui/rocker-switch": [
        "./src/registry/bases/ui-sdk/audio-ui/elements/rocker-switch.tsx"
      ],
      "@/primitives/envelope": ["./src/registry/primitives/envelope/core.ts"],
      "@/primitives/fader": ["./src/registry/primitives/fader/core.ts"],
      "@/primitives/knob": ["./src/registry/primitives/knob/core.ts"],
      "@/primitives/meter": ["./src/registry/primitives/meter/core.ts"],
      "@/primitives/pad": ["./src/registry/primitives/pad/core.ts"],
      "@/primitives/piano": ["./src/registry/primitives/piano/core.ts"],
      "@/primitives/piano-roll": [
        "./src/registry/primitives/piano-roll/core.ts"
      ],
      "@/primitives/plot": ["./src/registry/primitives/plot/core.ts"],
      "@/primitives/sequencer": ["./src/registry/primitives/sequencer/core.ts"],
      "@/primitives/timeline": ["./src/registry/primitives/timeline/core.ts"],
      "@/primitives/waveform": ["./src/registry/primitives/waveform/core.ts"],
      "@/primitives/xypad": ["./src/registry/primitives/xypad/core.ts"],
      "@/engine/*": ["./src/registry/lib/engine/*/index.ts"],
      "@/webgl/*": ["./src/registry/lib/webgl/*/index.ts"],
      "@audio-ui/icons": ["../../packages/icons/src/core/index.ts"],
      "@audio-ui/icons/react": [
        "../../packages/icons/src/providers/react/index.tsx"
      ],
      "fumadocs-mdx:collections/*": ["./.source/*"]
    },
    "types": ["bun", "mdx", "node", "react", "react-dom", "vite/client"]
  },
  // The Vue and Svelte demos and adapters are listed so the paths above reach their imports in the build, as in the .ts files: TypeScript itself does not read them.
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.vue",
    "**/*.svelte",
    "vite.config.mts"
  ],
  "exclude": ["node_modules"]
}
