{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/registry/bases/base/ui/toggle": [
        "./src/registry/bases/ui-sdk/ui/toggle.tsx"
      ],
      "@/registry/bases/base/ui/toggle-group": [
        "./src/registry/bases/ui-sdk/ui/toggle-group.tsx"
      ],
      "@/registry/bases/base/ui/input": [
        "./src/registry/bases/ui-sdk/ui/input.tsx"
      ],
      "@/registry/bases/base/ui/slider": [
        "./src/registry/bases/ui-sdk/ui/slider.tsx"
      ],
      "@/registry/bases/base/ui/kbd": [
        "./src/registry/bases/ui-sdk/ui/kbd.tsx"
      ],
      "@/registry/bases/base/ui/button-group": [
        "./src/registry/bases/ui-sdk/ui/button-group.tsx"
      ],
      "@/registry/bases/base/ui/input-group": [
        "./src/registry/bases/ui-sdk/ui/input-group.tsx"
      ],
      "@/registry/bases/base/ui/textarea": [
        "./src/registry/bases/ui-sdk/ui/textarea.tsx"
      ],
      "@/registry/bases/base/ui/dialog": [
        "./src/registry/bases/ui-sdk/ui/dialog.tsx"
      ],
      "@/registry/bases/base/ui/button": [
        "./src/registry/bases/ui-sdk/ui/button.tsx"
      ],
      "@/registry/bases/base/ui/select": [
        "./src/registry/bases/ui-sdk/ui/select.tsx"
      ],
      "@/registry/bases/base/ui/dropdown-menu": [
        "./src/registry/bases/ui-sdk/ui/dropdown-menu.tsx"
      ],
      "@/registry/bases/base/ui/context-menu": [
        "./src/registry/bases/ui-sdk/ui/context-menu.tsx"
      ],
      "@/registry/bases/base/ui/popover": [
        "./src/registry/bases/ui-sdk/ui/popover.tsx"
      ],
      "@/primitives/envelope": [
        "./src/registry/bases/base/primitives/envelope/envelope.ts"
      ],
      "@/primitives/fader": [
        "./src/registry/bases/base/primitives/fader/fader.ts"
      ],
      "@/primitives/knob": [
        "./src/registry/bases/base/primitives/knob/knob.ts"
      ],
      "@/primitives/meter": [
        "./src/registry/bases/base/primitives/meter/meter.ts"
      ],
      "@/primitives/pad": [
        "./src/registry/bases/base/primitives/pad/pad.ts"
      ],
      "@/primitives/piano": [
        "./src/registry/bases/base/primitives/piano/piano.ts"
      ],
      "@/primitives/piano-roll": [
        "./src/registry/bases/base/primitives/piano-roll/piano-roll.ts"
      ],
      "@/primitives/plot": [
        "./src/registry/bases/base/primitives/plot/plot.ts"
      ],
      "@/primitives/sequencer": [
        "./src/registry/bases/base/primitives/sequencer/sequencer.ts"
      ],
      "@/primitives/timeline": [
        "./src/registry/bases/base/primitives/timeline/timeline.ts"
      ],
      "@/primitives/waveform": [
        "./src/registry/bases/base/primitives/waveform/waveform.ts"
      ],
      "@/primitives/xypad": [
        "./src/registry/bases/base/primitives/xypad/xypad.ts"
      ],
      "@/engine/*": ["./src/registry/bases/base/lib/engine/*/index.ts"],
      "@/gl/*": ["./src/registry/bases/base/lib/gl/*/index.ts"],
      "@audio-ui/icons": ["../../packages/icons/src/core/index.ts"],
      "@audio-ui/icons/react": [
        "../../packages/icons/src/providers/react/index.tsx"
      ],
      "fumadocs-mdx:collections/*": ["./.source/*"]
    },
    "types": ["bun", "mdx", "node", "react", "react-dom", "vite/client"]
  },
  // The Vue and Svelte demos and adapters are listed so the paths above reach their imports in the build, as in the .ts files: TypeScript itself does not read them.
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.vue",
    "**/*.svelte",
    "vite.config.mts"
  ],
  "exclude": ["node_modules"]
}
