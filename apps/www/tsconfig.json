{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@audio-ui/core": ["../../packages/core/src/index.ts"],
      "@audio-ui/core/internal": ["../../packages/core/src/internal.ts"],
      "@audio-ui/core/*": ["../../packages/core/src/primitives/*/index.ts"],
      "@audio-ui/engine/*": ["../../packages/engine/src/*/index.ts"],
      "@audio-ui/elements": ["../../packages/elements/src/index.ts"],
      "@audio-ui/elements/*": ["../../packages/elements/src/*/index.ts"],
      "@audio-ui/icons": ["../../packages/icons/src/core/index.ts"],
      "@audio-ui/icons/react": [
        "../../packages/icons/src/providers/react/index.tsx"
      ],
      "@audio-ui/react": ["../../packages/ui/src/index.ts"],
      "fumadocs-mdx:collections/*": ["./.source/*"]
    },
    "types": ["bun", "mdx", "node", "react", "react-dom", "vite/client"]
  },
  "include": ["**/*.ts", "**/*.tsx", "vite.config.mts"],
  "exclude": ["node_modules"]
}
