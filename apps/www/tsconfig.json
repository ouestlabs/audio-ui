{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@audio-ui/core": ["../../packages/core/src/index.ts"],
      "@audio-ui/core/internal": ["../../packages/core/src/internal.ts"],
      "@audio-ui/core/*": [
        "../../packages/core/src/primitives/*/index.ts",
        "../../packages/core/src/audio/*/index.ts"
      ],
      "@audio-ui/react": ["../../packages/ui/src/index.ts"],
      "fumadocs-mdx:collections/*": ["./.source/*"]
    },
    "types": ["bun", "mdx", "node", "react", "react-dom"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
