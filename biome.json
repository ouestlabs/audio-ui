{
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack",
    "ultracite/biome/vitest"
  ],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!**/.next",
      "!**/dist",
      "!**/.turbo",
      "!**/dev-dist",
      "!**/.zed",
      "!**/.vscode",
      "!**/routeTree.gen.ts",
      "!apps/www/src/registry/icons/__*__.ts",
      "!**/.source",
      "!apps/www/public/r"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "noEnum": "off",
        "noNamespace": "off",
        "noExportedImports": "off",
        "useConsistentArrayType": "off",
        "useFilenamingConvention": "off",
        "useUnifiedTypeSignatures": "off",
        "useReadonlyClassProperties": "off",
        "useConsistentTypeDefinitions": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "noNamespaceImport": "off"
      },
      "nursery": "off",
      "suspicious": {
        "noUnknownAttribute": {
          "level": "error",
          "options": { "ignore": ["href", "precedence"] }
        },
        "noConsole": "off",
        "noExplicitAny": "off",
        "noBitwiseOperators": "off",
        "noDuplicateProperties": "off",
        "noShadowRestrictedNames": "off",
        "noDuplicateCustomProperties": "off",
        "useAdjacentOverloadSignatures": "off"
      },
      "a11y": {
        "useSemanticElements": "off",
        "noNoninteractiveElementInteractions": "off"
      }
    }
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "overrides": [
    {
      "includes": ["packages/react/bench/*"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off",
            "noUnusedFunctionParameters": "off"
          },
          "performance": {
            "noAwaitInLoops": "off",
            "noJsxPropsBind": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noShadow": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/react/src/primitives/*/test/*.bench.tsx",
        "packages/react/test/bench.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noJsxPropsBind": "off"
          },
          "suspicious": {
            "noMisplacedAssertion": "off"
          }
        }
      }
    }
  ]
}
