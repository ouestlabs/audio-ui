{
  "name": "@audio-ui/core",
  "version": "0.7.0",
  "description": "The framework-agnostic logic of audio/ui's primitives: values and scales, geometry, live sources, frame scheduling.",
  "keywords": [
    "audio-ui",
    "audio",
    "headless",
    "primitives"
  ],
  "homepage": "https://github.com/ouestlabs/audio-ui/tree/main/packages/core",
  "bugs": {
    "url": "https://github.com/ouestlabs/audio-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ouestlabs/audio-ui.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./envelope": {
      "types": "./dist/primitives/envelope/index.d.ts",
      "import": "./dist/envelope.js"
    },
    "./fader": {
      "types": "./dist/primitives/fader/index.d.ts",
      "import": "./dist/fader.js"
    },
    "./analysis": {
      "types": "./dist/audio/analysis/index.d.ts",
      "import": "./dist/analysis.js"
    },
    "./device": {
      "types": "./dist/audio/device/index.d.ts",
      "import": "./dist/device.js"
    },
    "./midi": {
      "types": "./dist/audio/midi/index.d.ts",
      "import": "./dist/midi.js"
    },
    "./pitch": {
      "types": "./dist/audio/pitch/index.d.ts",
      "import": "./dist/pitch.js"
    },
    "./time": {
      "types": "./dist/audio/time/index.d.ts",
      "import": "./dist/time.js"
    },
    "./knob": {
      "types": "./dist/primitives/knob/index.d.ts",
      "import": "./dist/knob.js"
    },
    "./meter": {
      "types": "./dist/primitives/meter/index.d.ts",
      "import": "./dist/meter.js"
    },
    "./pad": {
      "types": "./dist/primitives/pad/index.d.ts",
      "import": "./dist/pad.js"
    },
    "./piano": {
      "types": "./dist/primitives/piano/index.d.ts",
      "import": "./dist/piano.js"
    },
    "./piano-roll": {
      "types": "./dist/primitives/piano-roll/index.d.ts",
      "import": "./dist/piano-roll.js"
    },
    "./plot": {
      "types": "./dist/primitives/plot/index.d.ts",
      "import": "./dist/plot.js"
    },
    "./sequencer": {
      "types": "./dist/primitives/sequencer/index.d.ts",
      "import": "./dist/sequencer.js"
    },
    "./timeline": {
      "types": "./dist/primitives/timeline/index.d.ts",
      "import": "./dist/timeline.js"
    },
    "./waveform": {
      "types": "./dist/primitives/waveform/index.d.ts",
      "import": "./dist/waveform.js"
    },
    "./xypad": {
      "types": "./dist/primitives/xypad/index.d.ts",
      "import": "./dist/xypad.js"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:pkg": "bunx --bun tsup && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist node_modules .turbo",
    "dev": "bunx --bun tsup --watch",
    "lint": "biome check --write .",
    "lint:fix": "biome check --write --unsafe .",
    "test": "bun test"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@types/bun": "1.4.2",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
