{
  "name": "@audio-ui/react",
  "version": "0.1.2",
  "description": "A collection of React UI primitives for Audio UI.",
  "license": "MIT",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ouestlabs/audio-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/ouestlabs/audio-ui/tree/main/packages/ui",
  "bugs": {
    "url": "https://github.com/ouestlabs/audio-ui/issues"
  },
  "keywords": [
    "audio-ui",
    "react",
    "ui",
    "primitives"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./envelope": {
      "types": "./dist/envelope.d.ts",
      "import": "./dist/envelope.js"
    },
    "./fader": {
      "types": "./dist/fader.d.ts",
      "import": "./dist/fader.js"
    },
    "./knob": {
      "types": "./dist/knob.d.ts",
      "import": "./dist/knob.js"
    },
    "./meter": {
      "types": "./dist/meter.d.ts",
      "import": "./dist/meter.js"
    },
    "./piano": {
      "types": "./dist/piano.d.ts",
      "import": "./dist/piano.js"
    },
    "./piano-roll": {
      "types": "./dist/piano-roll.d.ts",
      "import": "./dist/piano-roll.js"
    },
    "./ruler": {
      "types": "./dist/ruler.d.ts",
      "import": "./dist/ruler.js"
    },
    "./sequencer": {
      "types": "./dist/sequencer.d.ts",
      "import": "./dist/sequencer.js"
    },
    "./source": {
      "types": "./dist/source.d.ts",
      "import": "./dist/source.js"
    },
    "./waveform": {
      "types": "./dist/waveform.d.ts",
      "import": "./dist/waveform.js"
    },
    "./xypad": {
      "types": "./dist/xypad.d.ts",
      "import": "./dist/xypad.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:pkg": "bunx --bun tsup && tsc -p tsconfig.build.json",
    "dev": "bunx --bun tsup --watch",
    "lint": "biome check --write .",
    "lint:fix": "biome check --write --unsafe .",
    "test": "bun test",
    "clean": "rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "@audio-ui/typescript": "latest",
    "@base-ui/react": "^1.9.0",
    "@happy-dom/global-registrator": "^20.10.6",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "@types/react": "^18 || ^19",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
