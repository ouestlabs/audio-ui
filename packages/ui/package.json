{
  "name": "@audio-ui/react",
  "version": "0.9.0",
  "description": "Accessible, headless React primitives for audio interfaces: knobs, faders, XY pads, envelopes, meters, waveforms, timelines, step sequencers, drum pads, piano keyboards and piano rolls.",
  "keywords": [
    "audio-ui",
    "react",
    "audio",
    "headless",
    "primitives",
    "accessible",
    "knob",
    "fader",
    "slider",
    "meter",
    "waveform",
    "envelope",
    "xy-pad",
    "piano-roll",
    "sequencer",
    "midi",
    "web-audio",
    "daw",
    "synth",
    "music"
  ],
  "homepage": "https://www.audio-ui.dev/docs/primitives",
  "bugs": {
    "url": "https://github.com/ouestlabs/audio-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ouestlabs/audio-ui.git",
    "directory": "packages/ui"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./envelope": {
      "types": "./dist/entries/envelope.d.ts",
      "import": "./dist/envelope.js"
    },
    "./fader": {
      "types": "./dist/entries/fader.d.ts",
      "import": "./dist/fader.js"
    },
    "./knob": {
      "types": "./dist/entries/knob.d.ts",
      "import": "./dist/knob.js"
    },
    "./meter": {
      "types": "./dist/entries/meter.d.ts",
      "import": "./dist/meter.js"
    },
    "./pad": {
      "types": "./dist/entries/pad.d.ts",
      "import": "./dist/pad.js"
    },
    "./piano": {
      "types": "./dist/entries/piano.d.ts",
      "import": "./dist/piano.js"
    },
    "./piano-roll": {
      "types": "./dist/entries/piano-roll.d.ts",
      "import": "./dist/piano-roll.js"
    },
    "./plot": {
      "types": "./dist/entries/plot.d.ts",
      "import": "./dist/plot.js"
    },
    "./sequencer": {
      "types": "./dist/entries/sequencer.d.ts",
      "import": "./dist/sequencer.js"
    },
    "./timeline": {
      "types": "./dist/entries/timeline.d.ts",
      "import": "./dist/timeline.js"
    },
    "./source": {
      "types": "./dist/source.d.ts",
      "import": "./dist/source.js"
    },
    "./waveform": {
      "types": "./dist/entries/waveform.d.ts",
      "import": "./dist/waveform.js"
    },
    "./xypad": {
      "types": "./dist/entries/xypad.d.ts",
      "import": "./dist/xypad.js"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "bench": "bun test ./src/primitives/*/test/*.bench.tsx",
    "bench:browsers": "bun bench/browsers.ts",
    "build:pkg": "bunx --bun tsup && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist node_modules .turbo",
    "dev": "bunx --bun tsup --watch",
    "lint": "biome check --write .",
    "lint:fix": "biome check --write --unsafe .",
    "size": "bun scripts/size.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@audio-ui/core": "^0.17.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "1.64.0",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@types/react": "^18 || ^19",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
