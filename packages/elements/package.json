{
  "name": "@audio-ui/elements",
  "version": "0.4.0",
  "description": "Accessible, headless custom elements for audio interfaces.",
  "keywords": [
    "audio-ui",
    "custom-elements",
    "web-components",
    "audio",
    "headless",
    "accessible",
    "knob",
    "fader",
    "slider",
    "web-audio",
    "daw",
    "synth",
    "music"
  ],
  "homepage": "https://www.audio-ui.dev/docs/custom-elements",
  "bugs": {
    "url": "https://github.com/ouestlabs/audio-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ouestlabs/audio-ui.git",
    "directory": "packages/elements"
  },
  "license": "MIT",
  "sideEffects": [
    "./dist/*.js",
    "./src/*/index.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./envelope": {
      "types": "./dist/envelope/index.d.ts",
      "import": "./dist/envelope.js"
    },
    "./fader": {
      "types": "./dist/fader/index.d.ts",
      "import": "./dist/fader.js"
    },
    "./knob": {
      "types": "./dist/knob/index.d.ts",
      "import": "./dist/knob.js"
    },
    "./meter": {
      "types": "./dist/meter/index.d.ts",
      "import": "./dist/meter.js"
    },
    "./pad": {
      "types": "./dist/pad/index.d.ts",
      "import": "./dist/pad.js"
    },
    "./piano": {
      "types": "./dist/piano/index.d.ts",
      "import": "./dist/piano.js"
    },
    "./piano-roll": {
      "types": "./dist/piano-roll/index.d.ts",
      "import": "./dist/piano-roll.js"
    },
    "./plot": {
      "types": "./dist/plot/index.d.ts",
      "import": "./dist/plot.js"
    },
    "./sequencer": {
      "types": "./dist/sequencer/index.d.ts",
      "import": "./dist/sequencer.js"
    },
    "./timeline": {
      "types": "./dist/timeline/index.d.ts",
      "import": "./dist/timeline.js"
    },
    "./waveform": {
      "types": "./dist/waveform/index.d.ts",
      "import": "./dist/waveform.js"
    },
    "./xypad": {
      "types": "./dist/xypad/index.d.ts",
      "import": "./dist/xypad.js"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:pkg": "bunx --bun tsup && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist node_modules .turbo",
    "dev": "bunx --bun tsup --watch",
    "lint": "biome check --write .",
    "lint:fix": "biome check --write --unsafe .",
    "size": "bun scripts/size.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@audio-ui/core": "^0.29.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "1.4.2",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
