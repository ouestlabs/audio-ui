{
  "name": "@audio-ui/utils",
  "version": "0.0.5",
  "description": "A collection of utility functions for Audio UI.",
  "keywords": [
    "audio-ui",
    "utils"
  ],
  "homepage": "https://github.com/ouestlabs/audio-ui/tree/main/packages/utils",
  "bugs": {
    "url": "https://github.com/ouestlabs/audio-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ouestlabs/audio-ui.git",
    "directory": "packages/utils"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.js"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:pkg": "tsup && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist node_modules .turbo",
    "dev": "tsup --watch",
    "lint": "biome check --write .",
    "lint:fix": "biome check --write --unsafe ."
  },
  "devDependencies": {
    "@audio-ui/typescript": "latest",
    "@types/bun": "1.4.2",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
